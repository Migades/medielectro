{% extends 'base.html.twig' %}
{% block title %}Instalación de electrodomésticos en Valencia · Medielectro{% endblock %}

{% block body %}
<style>
    /* ── Breadcrumb ── */
    .breadcrumb-bar { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--muted); margin:16px 0 28px; }
    .breadcrumb-bar a { color:var(--muted); text-decoration:none; }
    .breadcrumb-bar a:hover { color:var(--brand); }

    /* ── Hero ── */
    .inst-hero { display:grid; grid-template-columns:1fr 380px; gap:32px; align-items:center; margin-bottom:48px; }
    .inst-hero__title { font-size:34px; font-weight:900; letter-spacing:-.6px; margin:0 0 16px; line-height:1.1; }
    .inst-hero__title span { color:var(--brand); }
    .inst-hero__sub { font-size:16px; font-weight:700; color:var(--text); margin:0 0 16px; }
    .inst-hero__checks { list-style:none; margin:0 0 28px; padding:0; display:flex; flex-direction:column; gap:10px; }
    .inst-hero__checks li { display:flex; align-items:center; gap:10px; font-size:14px; color:var(--muted); }
    .inst-hero__checks li svg { color:var(--brand); flex-shrink:0; }
    .inst-hero__img { border-radius:20px; overflow:hidden; background:#f3f4f6; aspect-ratio:4/3; display:flex; align-items:center; justify-content:center; }
    .inst-hero__img img { width:100%; height:100%; object-fit:cover; }
    .inst-hero__img-placeholder { display:flex; flex-direction:column; align-items:center; gap:12px; color:#c8d0da; }

    /* ── Sección tipo electrodoméstico ── */
    .inst-section { margin:48px 0; }
    .inst-section__title { font-size:20px; font-weight:900; letter-spacing:-.3px; margin:0 0 20px; padding-bottom:12px; border-bottom:2px solid var(--border); }
    .inst-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; }
    .inst-card { background:var(--card); border:1px solid var(--border); border-radius:14px; padding:20px 14px; display:flex; flex-direction:column; align-items:center; gap:10px; text-align:center; text-decoration:none; color:var(--text); transition:border-color .15s, box-shadow .15s; }
    .inst-card:hover { border-color:var(--brand); box-shadow:0 4px 16px rgba(227,6,19,.1); }
    .inst-card__icon { width:52px; height:52px; background:#f9fafb; border:1px solid var(--border); border-radius:14px; display:flex; align-items:center; justify-content:center; }
    .inst-card__icon img { width:36px; height:36px; object-fit:contain; }
    .inst-card__name { font-size:12px; font-weight:700; line-height:1.3; color:var(--text); }

    /* ── FAQ ── */
    .faq { margin:48px 0; }
    .faq__title { font-size:22px; font-weight:900; margin:0 0 20px; letter-spacing:-.3px; }
    .faq-item { border-bottom:1px solid var(--border); }
    .faq-item summary { list-style:none; padding:18px 0; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:15px; font-weight:700; color:var(--text); }
    .faq-item summary::-webkit-details-marker { display:none; }
    .faq-item summary::after { content:''; width:10px; height:10px; border-right:2px solid #9ca3af; border-bottom:2px solid #9ca3af; transform:rotate(45deg); flex-shrink:0; margin-top:-4px; transition:transform .2s; }
    .faq-item[open] summary::after { transform:rotate(-135deg); margin-top:4px; }
    .faq-item[open] summary { color:var(--brand); }
    .faq-item__body { padding:0 0 18px; font-size:14px; color:var(--muted); line-height:1.7; }

    /* ── CTA ── */
    .inst-cta { background:linear-gradient(135deg,#111827 0%,#1f2937 100%); border-radius:20px; padding:44px 56px; display:flex; align-items:center; justify-content:space-between; gap:32px; flex-wrap:wrap; position:relative; overflow:hidden; margin:48px 0; }
    .inst-cta::before { content:''; position:absolute; inset:0; background:radial-gradient(circle at 80% 50%,rgba(227,6,19,.2),transparent 55%); }
    .inst-cta__text { position:relative; z-index:1; }
    .inst-cta h2 { font-size:26px; font-weight:900; color:white; margin:0 0 8px; letter-spacing:-.4px; }
    .inst-cta p { font-size:14px; color:rgba(255,255,255,.7); margin:0; }
    .inst-cta__actions { display:flex; gap:12px; flex-wrap:wrap; position:relative; z-index:1; }
    .btn-inst-primary { display:inline-flex; align-items:center; gap:8px; background:var(--brand); color:#fff; border-radius:12px; padding:14px 28px; font-size:15px; font-weight:800; text-decoration:none; transition:opacity .15s; }
    .btn-inst-primary:hover { opacity:.9; }
    .btn-inst-ghost { display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,.1); color:white; border:1px solid rgba(255,255,255,.2); border-radius:12px; padding:14px 28px; font-size:15px; font-weight:700; text-decoration:none; transition:background .15s; }
    .btn-inst-ghost:hover { background:rgba(255,255,255,.18); }

    @media(max-width:960px) {
        .inst-hero { grid-template-columns:1fr; }
        .inst-hero__img { display:none; }
        .inst-grid { grid-template-columns:repeat(3,1fr); }
        .inst-cta { padding:32px; }
    }
    @media(max-width:640px) {
        .inst-grid { grid-template-columns:repeat(2,1fr); }
    }
</style>

<div class="breadcrumb-bar">
    <a href="{{ path('app_home') }}">Inicio</a>
    <span>›</span>
    <span>Instalación de electrodomésticos</span>
</div>

