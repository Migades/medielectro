{% extends 'base.html.twig' %}
{% block title %}Instalación de electrodomésticos en Valencia · Medielectro{% endblock %}

{% block body %}
    <style>
        .svc-hero {
            display: grid;
            grid-template-columns: 1fr 420px;
            gap: 20px;
            margin: 24px 0;
            align-items: center;
        }

        .svc-hero__content { display: flex; flex-direction: column; gap: 16px; }

        .svc-hero__eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fff1f2;
            border: 1px solid #fecdd3;
            color: var(--brand);
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 5px 12px;
            width: fit-content;
        }

        .svc-hero__title {
            font-size: 36px;
            font-weight: 900;
            line-height: 1.1;
            letter-spacing: -.8px;
            margin: 0;
        }

        .svc-hero__sub {
            font-size: 16px;
            color: var(--muted);
            line-height: 1.6;
            margin: 0;
        }

        .svc-hero__actions { display: flex; gap: 10px; flex-wrap: wrap; }

        .svc-hero__card {
            background: linear-gradient(135deg, #1e3a5f 0%, #1a3250 100%);
            border-radius: 20px;
            padding: 36px;
            color: white;
            position: relative;
            overflow: hidden;
            min-height: 280px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .svc-hero__card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(227,6,19,.2), transparent 55%);
        }

        .svc-hero__card-icon {
            font-size: 52px;
            position: relative;
            z-index: 1;
        }

        .svc-hero__card-text {
            position: relative;
            z-index: 1;
        }

        .svc-hero__card-text h3 {
            font-size: 22px;
            font-weight: 900;
            margin: 0 0 6px;
            letter-spacing: -.4px;
        }

        .svc-hero__card-text p {
            font-size: 13px;
            color: rgba(255,255,255,.7);
            margin: 0;
            line-height: 1.5;
        }

        .value-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin: 40px 0;
        }

        .value-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .value-card__icon {
            width: 48px; height: 48px;
            background: #fff1f2;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }

        .value-card__title { font-size: 15px; font-weight: 800; margin: 0; }
        .value-card__text { font-size: 13px; color: var(--muted); line-height: 1.6; margin: 0; }

        .install-types {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-top: 24px;
        }

        .install-type {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px 24px;
        }

        .install-type__header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .install-type__icon {
            width: 44px; height: 44px;
            background: #f9fafb;
            border: 1px solid var(--border);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }

        .install-type__title { font-size: 15px; font-weight: 800; margin: 0; }

        .install-type ul {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .install-type ul li {
            font-size: 13px;
            color: var(--muted);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .install-type ul li::before {
            content: '';
            width: 5px; height: 5px;
            background: var(--brand);
            border-radius: 50%;
            flex-shrink: 0;
        }

        .svc-cta {
            background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            color: white;
            margin: 40px 0;
            position: relative;
            overflow: hidden;
        }

        .svc-cta::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(227,6,19,.2), transparent 50%);
        }

        .svc-cta h2 {
            font-size: 26px;
            font-weight: 900;
            margin: 0 0 10px;
            letter-spacing: -.4px;
            position: relative;
            z-index: 1;
        }

        .svc-cta p {
            font-size: 15px;
            color: rgba(255,255,255,.75);
            margin: 0 0 24px;
            position: relative;
            z-index: 1;
        }

        .svc-cta__actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            position: relative;
            z-index: 1;
        }

        .btn-white {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: white;
            color: #111827;
            border: none;
            border-radius: 12px;
            padding: 14px 28px;
            font-size: 15px;
            font-weight: 800;
            text-decoration: none;
            transition: opacity .15s;
        }

        .btn-white:hover { opacity: .9; }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.1);
            color: white;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 12px;
            padding: 14px 28px;
            font-size: 15px;
            font-weight: 700;
            text-decoration: none;
            transition: background .15s;
        }

        .btn-ghost:hover { background: rgba(255,255,255,.18); }

        @media (max-width: 900px) {
            .svc-hero { grid-template-columns: 1fr; }
            .svc-hero__card { min-height: 200px; }
            .value-grid { grid-template-columns: 1fr; }
            .install-types { grid-template-columns: 1fr; }
        }
    </style>

    <div style="margin:16px 0 24px;display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)">
        <a href="{{ path('app_home') }}" style="color:var(--muted);text-decoration:none">Inicio</a>
        <span>›</span>
        <span>Instalación</span>
    </div>

    <div class="svc-hero">
        <div class="svc-hero__content">
            <span class="svc-hero__eyebrow">Instalación profesional</span>
            <h1 class="svc-hero__title">Instalamos tu electrodoméstico en Valencia</h1>
            <p class="svc-hero__sub">
                Instalación profesional en tu domicilio o negocio. Personal cualificado,
                materiales incluidos y entrega con puesta en marcha.
            </p>
            <div class="svc-hero__actions">
                <a class="btn btn-primary" href="tel:963501675">📞 Pedir cita</a>
                <a class="btn" href="{{ path('app_catalog') }}">Ver catálogo</a>
            </div>
        </div>

        <div class="svc-hero__card">
            <div class="svc-hero__card-text">
                <h3>Instalación en 24h</h3>
                <p>Compramos y entregamos en tu domicilio o negocio con instalación incluida. Rápido, seguro y sin complicaciones.</p>
            </div>
        </div>
    </div>

    <div class="value-grid">
        <div class="value-card">
            <h3 class="value-card__title">Personal cualificado</h3>
            <p class="value-card__text">Nuestros técnicos están formados y certificados para instalar todo tipo de electrodomésticos con seguridad.</p>
        </div>
        <div class="value-card">
            <h3 class="value-card__title">Materiales incluidos</h3>
            <p class="value-card__text">Todos los materiales necesarios para la instalación están incluidos. Sin sorpresas ni costes adicionales.</p>
        </div>
        <div class="value-card">
            <h3 class="value-card__title">Recogida del antiguo</h3>
            <p class="value-card__text">Nos llevamos tu electrodoméstico antiguo sin coste adicional y lo gestionamos de forma responsable.</p>
        </div>
    </div>

    <div style="margin:40px 0">
        <h2 style="font-size:22px;font-weight:900;margin:0 0 6px;letter-spacing:-.3px">¿Qué instalamos?</h2>
        <p style="color:var(--muted);font-size:14px;margin:0 0 4px">Para el hogar y el negocio</p>

        <div class="install-types">
            <div class="install-type">
                <div class="install-type__header">
                    <div class="install-type__icon">🏠</div>
                    <h3 class="install-type__title">Hogar</h3>
                </div>
                <ul>
                    <li>Lavadoras y secadoras</li>
                    <li>Lavavajillas</li>
                    <li>Hornos y placas de cocción</li>
                    <li>Campanas extractoras</li>
                    <li>Frigoríficos y congeladores</li>
                    <li>Aire acondicionado doméstico</li>
                </ul>
            </div>

            <div class="install-type">
                <div class="install-type__header">
                    <div class="install-type__icon">🏢</div>
                    <h3 class="install-type__title">Negocio</h3>
                </div>
                <ul>
                    <li>Equipos de hostelería</li>
                    <li>Climatización industrial</li>
                    <li>Lavandería profesional</li>
                    <li>Cocinas industriales</li>
                    <li>Cámaras frigoríficas</li>
                    <li>Lavavajillas industrial</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="svc-cta">
        <h2>¿Necesitas instalar un electrodoméstico?</h2>
        <p>Contáctanos y te damos presupuesto sin compromiso. Atendemos en Valencia y alrededores.</p>
        <div class="svc-cta__actions">
            <a class="btn-white" href="tel:963501675"> 96 350 16 75</a>
            <a class="btn-ghost" href="{{ path('app_catalog') }}">Ver productos disponibles</a>
        </div>
    </div>
{% endblock %}
