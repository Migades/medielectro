<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Nuevo pedido {{ order.reference }}</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; background: #f6f7f9; color: #111827; }
        .wrapper { max-width: 600px; margin: 0 auto; padding: 32px 16px; }
        .card { background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .header { background: #111827; padding: 20px 32px; }
        .header__title { color: white; font-size: 16px; font-weight: 800; }
        .header__ref { color: rgba(255,255,255,.6); font-size: 13px; margin-top: 2px; }
        .alert { background: #effbf3; border-left: 4px solid #22c55e; padding: 14px 20px; font-size: 14px; font-weight: 600; color: #15803d; }
        .body { padding: 24px 32px; }
        .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: #6b7280; margin: 20px 0 10px; }
        .section-title:first-child { margin-top: 0; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 4px; }
        th { text-align: left; padding: 8px 12px; background: #f9fafb; color: #6b7280; font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .4px; border-bottom: 1px solid #e5e7eb; }
        td { padding: 10px 12px; border-bottom: 1px solid #f3f4f6; }
        tr:last-child td { border-bottom: none; }
        .total-row td { font-weight: 800; font-size: 15px; background: #f9fafb; }
        .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .meta-item { background: #f9fafb; border-radius: 8px; padding: 12px; font-size: 13px; }
        .meta-item__label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: #6b7280; margin-bottom: 4px; }
    </style>
</head>
<body>
<div class="wrapper">
    <div class="card">

        <div class="header">
            <div class="header__title">Nuevo pedido recibido</div>
            <div class="header__ref">{{ order.reference }} · {{ order.createdAt|date('d/m/Y H:i') }}</div>
        </div>

        <div class="alert">
            Total: {{ order.total|number_format(2, ',', '.') }} € · Estado ERP: pendiente de sincronizar
        </div>

        <div class="body">

            <p class="section-title">Cliente</p>
            <div class="meta">
                <div class="meta-item">
                    <div class="meta-item__label">Nombre</div>
                    {{ customer.name }}
                    {% if customer.company %}<br><em>{{ customer.company }}</em>{% endif %}
                </div>
                <div class="meta-item">
                    <div class="meta-item__label">Contacto</div>
                    {{ customer.email }}<br>
                    {{ customer.phone }}
                </div>
                {% if order.shippingAddress %}
                    <div class="meta-item" style="grid-column:1/-1">
                        <div class="meta-item__label">Dirección de entrega</div>
                        {{ order.shippingAddress }}
                        {% if order.shippingZip %}, {{ order.shippingZip }}{% endif %}
                        {% if order.shippingCity %} {{ order.shippingCity }}{% endif %}
                    </div>
                {% endif %}
                {% if order.notes %}
                    <div class="meta-item" style="grid-column:1/-1">
                        <div class="meta-item__label">Notas</div>
                        {{ order.notes }}
                    </div>
                {% endif %}
            </div>

            <p class="section-title">Líneas del pedido</p>
            <table>
                <thead>
                <tr>
                    <th>Artículo</th>
                    <th>Producto</th>
                    <th style="text-align:right">Uds.</th>
                    <th style="text-align:right">Precio ud.</th>
                    <th style="text-align:right">Subtotal</th>
                </tr>
                </thead>
                <tbody>
                {% for line in order.lines %}
                    <tr>
                        <td style="color:#6b7280;font-size:12px">{{ line.productArticle }}</td>
                        <td>
                            {{ line.productTitle }}
                            {% if line.productBrand %}<br><span style="color:#6b7280;font-size:12px">{{ line.productBrand }}</span>{% endif %}
                        </td>
                        <td style="text-align:right">{{ line.quantity }}</td>
                        <td style="text-align:right">{{ line.unitPrice|number_format(2, ',', '.') }} €</td>
                        <td style="text-align:right;font-weight:700">{{ line.subtotal|number_format(2, ',', '.') }} €</td>
                    </tr>
                {% endfor %}
                <tr class="total-row">
                    <td colspan="4" style="text-align:right">Total</td>
                    <td style="text-align:right">{{ order.total|number_format(2, ',', '.') }} €</td>
                </tr>
                </tbody>
            </table>

        </div>
    </div>
</div>
</body>
</html>
