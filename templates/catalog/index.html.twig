{% extends 'base.html.twig' %}
{% block title %}Catálogo{% endblock %}

{% block body %}
    <section class="section">
        <div class="section-title">
            <div>
                <h2>Catálogo</h2>
                <p>{{ totalProducts }} productos</p>
            </div>
        </div>

        <div class="catalog-layout">
            <aside class="card filters">
                <form method="get" action="{{ path('app_catalog') }}">
                    <div class="group">
                        <label>Buscar</label>
                        <input name="q" value="{{ filters.q }}" placeholder="Buscar por modelo o marca…">
                    </div>

                    <div class="group">
                        <label>Categoría</label>
                        <select name="family">
                            <option value="0">Todas</option>
                            {% set seenFamilies = [] %}
                            {% for f in families %}
                                {% set key = (f.name ?? '')|lower|trim %}
                                {% if key and (key not in seenFamilies) %}
                                    {% set seenFamilies = seenFamilies|merge([key]) %}
                                    <option value="{{ f.id }}" {% if filters.family == f.id %}selected{% endif %}>{{ f.name }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>

                    <div class="group">
                        <label>Marca</label>
                        <select name="brand">
                            <option value="">Todas</option>
                            {% for item in brands %}
                                <option value="{{ item }}" {% if filters.brand == item %}selected{% endif %}>{{ item }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="group">
                        <label>Ordenar</label>
                        <select name="sort">
                            <option value="recent" {% if filters.sort == 'recent' %}selected{% endif %}>Recomendados</option>
                            <option value="price_asc" {% if filters.sort == 'price_asc' %}selected{% endif %}>Precio: menor a mayor</option>
                            <option value="price_desc" {% if filters.sort == 'price_desc' %}selected{% endif %}>Precio: mayor a menor</option>
                        </select>
                    </div>

                    <div class="group">
                        <label>
                            <input type="checkbox" name="inStock" value="1" {% if filters.inStock == 1 %}checked{% endif %}>
                            Solo disponibles
                        </label>
                    </div>

                    <button class="btn btn-primary" type="submit" style="width:100%;">Aplicar</button>
                    <div style="margin-top:10px;">
                        <a class="btn" href="{{ path('app_catalog') }}" style="width:100%; justify-content:center;">Limpiar</a>
                    </div>
                </form>
            </aside>

            <section>
                <div class="grid catalog-grid">
                    {% for p in products %}
                        <a class="card product-card" href="{{ path('app_product_show', {article: p.article}) }}">
                            <div class="product-image">
                                {% if p.image %}
                                    <img src="{{ p.image }}" alt="{{ p.model }}">
                                {% else %}
                                    <div class="product-image-placeholder">📦</div>
                                {% endif %}
                            </div>

                            <div class="product-brand">{{ p.brand ?: 'Marca' }}</div>

                            {# Título más humano: description si existe, si no "Producto <marca>" #}
                            <div class="product-title">
                                {% if p.description is not empty %}
                                    {{ p.description|striptags|u.truncate(60, '…') }}
                                {% else %}
                                    Producto {{ p.brand ?: '' }}
                                {% endif %}
                            </div>

                            {# Modelo en pequeño para quien lo necesite #}
                            <div class="product-subtitle">
                                Modelo: {{ p.model }}
                            </div>

                            <div class="product-bottom">
                                <div class="product-price">
                                    {{ p.price|number_format(2, ',', '.') }} €
                                </div>

                                {% if p.stock > 0 %}
                                    <span class="product-stock ok">Disponible</span>
                                {% else %}
                                    <span class="product-stock warn">Consultar</span>
                                {% endif %}
                            </div>

                            <div class="product-cta">
                                <span class="btn btn-primary" style="width:100%; justify-content:center;">Ver detalle</span>
                            </div>
                        </a>
                    {% else %}
                        <div class="card">No hay resultados con esos filtros.</div>
                    {% endfor %}
                </div>

                {% if totalPages > 1 %}
                    <div class="pagination">
                        {% set params = filters|merge({}) %}
                        {% if currentPage > 1 %}
                            <a href="{{ path('app_catalog', params|merge({page: currentPage - 1})) }}">← Anterior</a>
                        {% endif %}

                        <span class="pill">Página {{ currentPage }} / {{ totalPages }}</span>

                        {% if currentPage < totalPages %}
                            <a href="{{ path('app_catalog', params|merge({page: currentPage + 1})) }}">Siguiente →</a>
                        {% endif %}
                    </div>
                {% endif %}
            </section>
        </div>
    </section>
{% endblock %}
