{% extends 'base.html.twig' %}

{% block title %}Catálogo{% endblock %}

{% block body %}
    <div style="max-width: 1400px; margin: 0 auto; padding: 2rem; font-family: Arial, sans-serif;">
        <h1 style="margin-bottom: 0.5rem;">Catálogo de productos</h1>
        <p style="margin-bottom: 2rem; color: #666;">
            Total productos: <strong>{{ totalProducts }}</strong>
        </p>

        <div style="overflow-x: auto; border: 1px solid #ddd; border-radius: 10px;">
            <table style="width: 100%; border-collapse: collapse; min-width: 1100px;">
                <thead style="background: #f5f5f5;">
                <tr>
                    <th style="text-align: left; padding: 12px; border-bottom: 1px solid #ddd;">Artículo</th>
                    <th style="text-align: left; padding: 12px; border-bottom: 1px solid #ddd;">Modelo</th>
                    <th style="text-align: left; padding: 12px; border-bottom: 1px solid #ddd;">Marca</th>
                    <th style="text-align: left; padding: 12px; border-bottom: 1px solid #ddd;">Familia</th>
                    <th style="text-align: left; padding: 12px; border-bottom: 1px solid #ddd;">Subfamilia</th>
                    <th style="text-align: right; padding: 12px; border-bottom: 1px solid #ddd;">Precio</th>
                    <th style="text-align: right; padding: 12px; border-bottom: 1px solid #ddd;">Stock</th>
                    <th style="text-align: center; padding: 12px; border-bottom: 1px solid #ddd;">Activo</th>
                    <th style="text-align: center; padding: 12px; border-bottom: 1px solid #ddd;">Obsoleto</th>
                </tr>
                </thead>
                <tbody>
                {% for product in products %}
                    <tr style="border-bottom: 1px solid #eee;">
                        <td style="padding: 12px;">{{ product.article }}</td>
                        <td style="padding: 12px;">{{ product.model }}</td>
                        <td style="padding: 12px;">{{ product.brand ?: '-' }}</td>
                        <td style="padding: 12px;">{{ product.family ? product.family.name : '-' }}</td>
                        <td style="padding: 12px;">{{ product.subfamily ? product.subfamily.name : '-' }}</td>
                        <td style="padding: 12px; text-align: right;">
                            {{ product.price|number_format(2, ',', '.') }} €
                        </td>
                        <td style="padding: 12px; text-align: right;">{{ product.stock }}</td>
                        <td style="padding: 12px; text-align: center;">
                            {% if product.isActive %}
                                ✅
                            {% else %}
                                ❌
                            {% endif %}
                        </td>
                        <td style="padding: 12px; text-align: center;">
                            {% if product.obsolete %}
                                ⚠️
                            {% else %}
                                —
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" style="padding: 20px; text-align: center;">
                            No hay productos.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% if totalPages > 1 %}
            <div style="display: flex; gap: 10px; align-items: center; justify-content: center; margin-top: 2rem; flex-wrap: wrap;">
                {% if currentPage > 1 %}
                    <a href="{{ path('app_catalog', {page: currentPage - 1}) }}"
                       style="padding: 10px 14px; border: 1px solid #ccc; border-radius: 8px; text-decoration: none; color: #222;">
                        ← Anterior
                    </a>
                {% endif %}

                <span style="padding: 10px 14px;">
                    Página <strong>{{ currentPage }}</strong> de <strong>{{ totalPages }}</strong>
                </span>

                {% if currentPage < totalPages %}
                    <a href="{{ path('app_catalog', {page: currentPage + 1}) }}"
                       style="padding: 10px 14px; border: 1px solid #ccc; border-radius: 8px; text-decoration: none; color: #222;">
                        Siguiente →
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
