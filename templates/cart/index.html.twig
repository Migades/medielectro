{% extends 'base.html.twig' %}
{% block title %}Carrito · Medielectro{% endblock %}

{% block body %}
<style>
.cart-layout { display:grid; grid-template-columns:1fr 340px; gap:20px; margin:24px 0; align-items:start; }
.cart-lines { background:var(--card); border:1px solid var(--border); border-radius:16px; overflow:hidden; }
.cart-lines__header { display:grid; grid-template-columns:1fr 130px 110px 40px; gap:12px; padding:12px 16px; background:#f9fafb; border-bottom:1px solid var(--border); font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:var(--muted); }
.cart-item { display:grid; grid-template-columns:1fr 130px 110px 40px; gap:12px; padding:14px 16px; border-bottom:1px solid #f3f4f6; align-items:center; }
.cart-item:last-child { border-bottom:none; }
.cart-item__product { display:flex; align-items:center; gap:12px; }
.cart-item__image { width:60px; height:60px; border-radius:10px; border:1px solid var(--border); background:#f8fafc; overflow:hidden; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:22px; color:#c8d0da; }
.cart-item__image img { width:100%; height:100%; object-fit:cover; }
.cart-item__brand { font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.4px; color:var(--muted); }
.cart-item__title { font-size:13px; font-weight:700; line-height:1.3; }
.cart-item__ref { font-size:11px; color:var(--muted); }
.qty-control { display:flex; align-items:center; border:1px solid var(--border); border-radius:8px; overflow:hidden; width:fit-content; }
.qty-btn { width:32px; height:32px; border:none; background:#f9fafb; cursor:pointer; font-size:16px; font-weight:700; color:var(--text); transition:background .15s; display:flex; align-items:center; justify-content:center; }
.qty-btn:hover { background:#f3f4f6; }
.qty-input { width:40px; height:32px; border:none; border-left:1px solid var(--border); border-right:1px solid var(--border); text-align:center; font-size:13px; font-weight:700; color:var(--text); background:white; outline:none; -moz-appearance:textfield; }
.qty-input::-webkit-outer-spin-button, .qty-input::-webkit-inner-spin-button { -webkit-appearance:none; }
.cart-item__subtotal { font-size:15px; font-weight:900; letter-spacing:-.3px; text-align:right; }
.cart-item__remove { display:flex; align-items:center; justify-content:center; width:32px; height:32px; border:none; background:none; cursor:pointer; color:#9ca3af; border-radius:8px; transition:background .15s,color .15s; }
.cart-item__remove:hover { background:#fff1f2; color:var(--brand); }
.cart-summary { position:sticky; top:168px; background:var(--card); border:1px solid var(--border); border-radius:16px; overflow:hidden; }
.cart-summary__header { padding:14px 18px; border-bottom:1px solid var(--border); font-size:14px; font-weight:800; }
.cart-summary__body { padding:16px 18px; display:flex; flex-direction:column; gap:10px; }
.summary-row { display:flex; justify-content:space-between; align-items:center; font-size:13px; }
.summary-row--total { border-top:1px solid var(--border); padding-top:12px; margin-top:4px; font-size:18px; font-weight:900; }
.summary-row__label { color:var(--muted); }
.summary-row--total .summary-row__label { color:var(--text); }
.btn-checkout { width:100%; padding:14px; background:var(--brand); color:white; border:none; border-radius:12px; font-size:15px; font-weight:800; cursor:pointer; transition:opacity .15s; text-align:center; text-decoration:none; display:block; margin-top:6px; }
.btn-checkout:hover { opacity:.88; }
.cart-empty { text-align:center; padding:64px 24px; color:var(--muted); }
.cart-empty__icon { font-size:48px; margin-bottom:16px; }
.cart-empty__title { font-size:18px; font-weight:800; color:var(--text); margin-bottom:8px; }
.flash-cart { background:#effbf3; border:1px solid #b7ebc6; color:#15803d; padding:12px 16px; border-radius:10px; font-size:13px; font-weight:600; margin-bottom:12px; }
@media(max-width:900px){ .cart-layout{grid-template-columns:1fr} .cart-summary{position:static} .cart-lines__header{display:none} .cart-item{grid-template-columns:1fr auto} }
</style>

<div style="margin:24px 0 12px">
    <h1 style="margin:0 0 4px;font-size:22px;font-weight:800">Carrito</h1>
    <p style="margin:0;color:var(--muted);font-size:13px">{{ count }} {{ count == 1 ? 'producto' : 'productos' }}</p>
</div>

{% for msg in app.flashes('cart_success') %}
    <div class="flash-cart">{{ msg }}</div>
{% endfor %}

{% if items is empty %}
    <div class="cart-empty">
        
        <div class="cart-empty__title">El carrito está vacío</div>
        <p>Añade productos desde el catálogo para continuar.</p>
        <a class="btn btn-primary" href="{{ path('app_catalog') }}">Ver catálogo</a>
    </div>
{% else %}
    <div class="cart-layout">
        <div class="cart-lines">
            <div class="cart-lines__header">
                <span>Producto</span>
                <span>Cantidad</span>
                <span style="text-align:right">Subtotal</span>
                <span></span>
            </div>
            {% for item in items %}
                <div class="cart-item" data-article="{{ item.article }}">
                    <div class="cart-item__product">
                        <div class="cart-item__image">
                            {% if item.image %}<img src="{{ item.image }}" alt="{{ item.title }}">{% endif %}
                        </div>
                        <div>
                            {% if item.brand %}<div class="cart-item__brand">{{ item.brand }}</div>{% endif %}
                            <div class="cart-item__title">{{ item.title }}</div>
                            <div class="cart-item__ref">Ref. {{ item.article }} · {{ item.price|number_format(2,',','.') }} € / ud.</div>
                        </div>
                    </div>
                    <div class="qty-control">
                        <button class="qty-btn" type="button" data-action="dec">−</button>
                        <input class="qty-input" type="number" value="{{ item.quantity }}" min="1" max="999">
                        <button class="qty-btn" type="button" data-action="inc">+</button>
                    </div>
                    <div class="cart-item__subtotal">{{ item.subtotal|number_format(2,',','.') }} €</div>
                    <button class="cart-item__remove" type="button" data-action="remove">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                    </button>
                </div>
            {% endfor %}
        </div>

        <div class="cart-summary">
            <div class="cart-summary__header">Resumen del pedido</div>
            <div class="cart-summary__body">
                {% for item in items %}
                    <div class="summary-row">
                        <span class="summary-row__label">{{ item.title|u.truncate(30,'…') }} ×{{ item.quantity }}</span>
                        <span>{{ item.subtotal|number_format(2,',','.') }} €</span>
                    </div>
                {% endfor %}
                <div class="summary-row summary-row--total">
                    <span class="summary-row__label">Total</span>
                    <span id="cartTotal">{{ total|number_format(2,',','.') }} €</span>
                </div>
                <p style="font-size:11px;color:var(--muted);margin:0">IVA incluido. Gastos de envío calculados en el siguiente paso.</p>
                <a class="btn-checkout" href="{{ path('app_cart_checkout') }}">Finalizar pedido →</a>
                <a class="btn" href="{{ path('app_catalog') }}" style="width:100%;justify-content:center;margin-top:4px">Seguir comprando</a>
            </div>
        </div>
    </div>
{% endif %}

<script>
(function(){
    function post(url, data){
        return fetch(url,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(data)}).then(r=>r.json());
    }
    function updateBadge(n){
        document.querySelectorAll('[data-cart-count]').forEach(el=>{
            el.textContent=n;
            el.style.display=n>0?'flex':'none';
        });
    }
    function recalcTotal(){
        let t=0;
        document.querySelectorAll('.cart-item').forEach(row=>{
            const price=parseFloat(row.dataset.price||0);
            const qty=parseInt(row.querySelector('.qty-input').value,10)||0;
            t+=price*qty;
        });
        const el=document.getElementById('cartTotal');
        if(el) el.textContent=t.toFixed(2).replace('.',',')+'  €';
    }
    document.querySelectorAll('.cart-item').forEach(row=>{
        // Extraer precio de la línea de referencia
        const ref=row.querySelector('.cart-item__ref')?.textContent||'';
        const m=ref.match(/([\d.,]+)\s*€\s*\/\s*ud/);
        if(m) row.dataset.price=m[1].replace('.','').replace(',','.');
        const price=parseFloat(row.dataset.price||0);
        const article=row.dataset.article;
        const inp=row.querySelector('.qty-input');

        row.querySelectorAll('.qty-btn').forEach(btn=>btn.addEventListener('click',async()=>{
            let q=parseInt(inp.value,10)||1;
            q=btn.dataset.action==='inc'?q+1:Math.max(1,q-1);
            inp.value=q;
            row.querySelector('.cart-item__subtotal').textContent=(price*q).toFixed(2).replace('.',',')+'  €';
            recalcTotal();
            const d=await post('/carrito/actualizar/'+encodeURIComponent(article),{quantity:q});
            updateBadge(d.count);
        }));

        inp.addEventListener('change',async()=>{
            const q=Math.max(1,parseInt(inp.value,10)||1);
            inp.value=q;
            row.querySelector('.cart-item__subtotal').textContent=(price*q).toFixed(2).replace('.',',')+'  €';
            recalcTotal();
            const d=await post('/carrito/actualizar/'+encodeURIComponent(article),{quantity:q});
            updateBadge(d.count);
        });

        row.querySelector('[data-action="remove"]').addEventListener('click',async()=>{
            row.style.opacity='.4';
            const d=await post('/carrito/eliminar/'+encodeURIComponent(article),{});
            updateBadge(d.count);
            row.remove();
            recalcTotal();
            if(!document.querySelector('.cart-item')) location.reload();
        });
    });
})();
</script>
{% endblock %}
