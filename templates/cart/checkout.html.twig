{% extends 'base.html.twig' %}
{% block title %}Checkout · Medielectro{% endblock %}

{% block body %}
<style>
.checkout-layout{display:grid;grid-template-columns:1fr 360px;gap:20px;margin:24px 0;align-items:start}
.checkout-form{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.checkout-form__section{padding:20px 24px;border-bottom:1px solid var(--border)}
.checkout-form__section:last-child{border-bottom:none}
.checkout-form__title{font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);margin:0 0 16px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group--full{grid-column:1/-1}
.form-label{font-size:12px;font-weight:700;color:var(--text)}
.form-label span{color:var(--brand)}
.form-input,.form-textarea{border:1px solid var(--border);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--text);background:#f9fafb;outline:none;transition:border-color .15s,background .15s;width:100%;box-sizing:border-box}
.form-input:focus,.form-textarea:focus{border-color:var(--brand);background:white}
.form-textarea{resize:vertical;min-height:80px}
.checkout-summary{position:sticky;top:168px;background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden}
.checkout-summary__header{padding:14px 18px;border-bottom:1px solid var(--border);font-size:14px;font-weight:800}
.checkout-summary__items{padding:12px 18px;border-bottom:1px solid var(--border)}
.checkout-summary__item{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:8px 0;border-bottom:1px solid #f3f4f6;font-size:12px}
.checkout-summary__item:last-child{border-bottom:none}
.checkout-summary__item-name{font-weight:600;flex:1;line-height:1.3}
.checkout-summary__item-qty{color:var(--muted)}
.checkout-summary__item-price{font-weight:700;white-space:nowrap}
.checkout-summary__footer{padding:14px 18px}
.checkout-total{display:flex;justify-content:space-between;font-size:18px;font-weight:900;margin-bottom:14px}
.payment-notice{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:10px 12px;font-size:12px;color:#92400e;margin-bottom:14px;line-height:1.5}
.btn-confirm{width:100%;padding:14px;background:var(--brand);color:white;border:none;border-radius:12px;font-size:15px;font-weight:800;cursor:pointer;transition:opacity .15s}
.btn-confirm:hover{opacity:.88}
.flash-error{background:#fff1f2;border:1px solid #fecdd3;color:var(--brand);padding:12px 16px;border-radius:10px;font-size:13px;font-weight:600;margin-bottom:12px}
@media(max-width:900px){.checkout-layout{grid-template-columns:1fr}.checkout-summary{position:static}.form-row{grid-template-columns:1fr}}
</style>

<div style="margin:24px 0 12px">
    <a href="{{ path('app_cart_index') }}" style="color:var(--muted);font-size:13px">← Volver al carrito</a>
</div>
<h1 style="margin:0 0 20px;font-size:22px;font-weight:800">Finalizar pedido</h1>

{% for msg in app.flashes('checkout_error') %}
    <div class="flash-error">{{ msg }}</div>
{% endfor %}

<div class="checkout-layout">
    <form id="checkoutForm" class="checkout-form" action="{{ path('app_cart_confirm') }}" method="post">
        <div class="checkout-form__section">
            <p class="checkout-form__title">Datos de contacto</p>
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Nombre completo <span>*</span></label>
                    <input class="form-input" type="text" name="name" required placeholder="Tu nombre">
                </div>
                <div class="form-group">
                    <label class="form-label">Email <span>*</span></label>
                    <input class="form-input" type="email" name="email" required placeholder="tu@email.com">
                </div>
                <div class="form-group">
                    <label class="form-label">Teléfono <span>*</span></label>
                    <input class="form-input" type="tel" name="phone" required placeholder="600 000 000" pattern="[0-9]{3} [0-9]{3} [0-9]{3}" inputmode="numeric" maxlength="11" title="Introduce 9 dígitos" oninput="var v=this.value.replace(/[^0-9]/g,'').slice(0,9);this.value=v.replace(/(\d{3})(?=\d)/g,'$1 ').trim()">
                </div>
                <div class="form-group">
                    <label class="form-label">Empresa (opcional)</label>
                    <input class="form-input" type="text" name="company" placeholder="Razón social">
                </div>
            </div>
        </div>
        <div class="checkout-form__section">
            <p class="checkout-form__title">Dirección de entrega</p>
            <div class="form-row">
                <div class="form-group form-group--full">
                    <label class="form-label">Dirección</label>
                    <input class="form-input" type="text" name="address" placeholder="Calle, número, piso…">
                </div>
                <div class="form-group">
                    <label class="form-label">Código postal</label>
                    <input class="form-input" type="text" name="zip" placeholder="46000">
                </div>
                <div class="form-group">
                    <label class="form-label">Población</label>
                    <input class="form-input" type="text" name="city" placeholder="Valencia">
                </div>
            </div>
        </div>
        <div class="checkout-form__section">
            <p class="checkout-form__title">Notas del pedido</p>
            <div class="form-group">
                <label class="form-label">Comentarios o instrucciones especiales</label>
                <textarea class="form-textarea" name="notes" placeholder="Horario de entrega preferido…"></textarea>
            </div>
        </div>
    </form>

    <div class="checkout-summary">
        <div class="checkout-summary__header">Tu pedido</div>
        <div class="checkout-summary__items">
            {% for item in items %}
                <div class="checkout-summary__item">
                    <span class="checkout-summary__item-name">{{ item.title|u.truncate(35,'…') }}</span>
                    <span class="checkout-summary__item-qty">×{{ item.quantity }}</span>
                    <span class="checkout-summary__item-price">{{ item.subtotal|number_format(2,',','.') }} €</span>
                </div>
            {% endfor %}
        </div>
        <div class="checkout-summary__footer">
            <div class="checkout-total"><span>Total</span><span>{{ total|number_format(2,',','.') }} €</span></div>
            <div class="payment-notice">El pago se gestionará en el siguiente paso una vez confirmemos la disponibilidad de tu pedido.</div>
            <button class="btn-confirm" type="submit" form="checkoutForm">Confirmar pedido →</button>
        </div>
    </div>
</div>
{% endblock %}
