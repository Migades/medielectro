{% extends 'base.html.twig' %}
{% block title %}Pedido confirmado · Medielectro{% endblock %}

{% block body %}
<style>
.confirmed-wrap{max-width:620px;margin:48px auto;text-align:center}
.confirmed-icon{width:72px;height:72px;background:#effbf3;border:2px solid #b7ebc6;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 20px}
.confirmed-wrap h1{margin:0 0 10px;font-size:26px;font-weight:800;letter-spacing:-.4px}
.confirmed-wrap p{margin:0 0 24px;color:var(--muted);font-size:15px;line-height:1.6}
.order-summary{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;text-align:left;margin:24px 0}
.order-summary__header{padding:12px 18px;background:#f9fafb;border-bottom:1px solid var(--border);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;color:var(--muted)}
.order-summary__item{display:flex;justify-content:space-between;align-items:center;padding:10px 18px;border-bottom:1px solid #f3f4f6;font-size:13px}
.order-summary__item:last-child{border-bottom:none}
.order-summary__total{display:flex;justify-content:space-between;padding:14px 18px;border-top:1px solid var(--border);font-size:16px;font-weight:900}
.contact-info{background:#f9fafb;border:1px solid var(--border);border-radius:12px;padding:16px 20px;font-size:13px;color:var(--muted);text-align:left;margin-bottom:20px;line-height:1.8}
.contact-info strong{color:var(--text)}
</style>

<div class="confirmed-wrap">
    <div class="confirmed-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
    <h1>Pedido recibido</h1>
    <p>Gracias, <strong>{{ order.name }}</strong>. Hemos recibido tu pedido correctamente.<br>
    Nos pondremos en contacto contigo en breve para confirmar disponibilidad y gestionar el pago.</p>

    <div class="order-summary">
        <div class="order-summary__header">Resumen</div>
        {% for item in order.items %}
            <div class="order-summary__item">
                <span>{{ item.title }} <span style="color:var(--muted)">×{{ item.quantity }}</span></span>
                <span style="font-weight:700">{{ item.subtotal|number_format(2,',','.') }} €</span>
            </div>
        {% endfor %}
        <div class="order-summary__total">
            <span>Total</span>
            <span>{{ order.total|number_format(2,',','.') }} €</span>
        </div>
    </div>

    <div class="contact-info">
        <strong>Datos de entrega</strong><br>
        {{ order.name }}<br>
        {{ order.email }} · {{ order.phone }}<br>
        {% if order.address %}{{ order.address }}{% endif %}
        {% if order.notes %}<br><em>Nota: {{ order.notes }}</em>{% endif %}
    </div>

    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href="{{ path('app_catalog') }}">Seguir comprando</a>
        <a class="btn" href="{{ path('app_home') }}">Volver al inicio</a>
    </div>
</div>
{% endblock %}
