{% extends 'base.html.twig' %}
{% block title %}{{ product.title ?: product.model }} · Medielectro{% endblock %}

{% block body %}
    <style>
        .product-detail{display:grid;grid-template-columns:420px 1fr;gap:24px;margin:24px 0;align-items:start}
        .product-detail__image{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;position:sticky;top:168px}
        .product-detail__image img{width:100%;height:100%;object-fit:cover}
        .product-detail__placeholder{display:flex;flex-direction:column;align-items:center;gap:8px;color:#c8d0da;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.4px}
        .product-detail__placeholder-icon{font-size:52px;opacity:.4}
        .product-detail__info{display:flex;flex-direction:column;gap:16px}
        .product-brand-badge{display:inline-flex;align-items:center;gap:6px;background:#fff1f2;border:1px solid #fecdd3;color:var(--brand);border-radius:999px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;padding:4px 10px}
        .product-detail h1{margin:8px 0 6px;font-size:24px;font-weight:900;line-height:1.2;letter-spacing:-.4px}
        .product-ref{font-size:12px;color:var(--muted)}
        .product-price-block{background:#f9fafb;border:1px solid var(--border);border-radius:14px;padding:16px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px}
        .product-price{font-size:32px;font-weight:900;letter-spacing:-1px;color:var(--text)}
        .product-price__pvpr{font-size:12px;color:var(--muted);margin-top:2px}
        .stock-pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px}
        .stock-pill--ok{background:#effbf3;color:#15803d;border:1px solid #b7ebc6}
        .stock-pill--warn{background:#fff7ea;color:#92400e;border:1px solid #ffe2b5}
        .add-to-cart{display:flex;gap:10px;align-items:center}
        .qty-select{display:flex;align-items:center;border:1px solid var(--border);border-radius:10px;overflow:hidden}
        .qty-select__btn{width:38px;height:46px;border:none;background:#f3f4f6;cursor:pointer;font-size:18px;font-weight:700;color:var(--text);transition:background .15s}
        .qty-select__btn:hover{background:#e5e7eb}
        .qty-select__input{width:48px;height:46px;border:none;border-left:1px solid var(--border);border-right:1px solid var(--border);text-align:center;font-size:15px;font-weight:700;color:var(--text);background:white;outline:none;-moz-appearance:textfield}
        .qty-select__input::-webkit-outer-spin-button,.qty-select__input::-webkit-inner-spin-button{-webkit-appearance:none}
        .btn-add-cart{flex:1;height:46px;background:var(--brand);color:white;border:none;border-radius:10px;font-size:14px;font-weight:800;cursor:pointer;transition:opacity .15s;display:flex;align-items:center;justify-content:center;gap:8px}
        .btn-add-cart:hover{opacity:.88}
        .btn-add-cart:disabled{opacity:.5;cursor:not-allowed}
        .flash-added{background:#effbf3;border:1px solid #b7ebc6;color:#15803d;border-radius:10px;padding:10px 14px;font-size:13px;font-weight:600;display:none;align-items:center;gap:8px}
        .flash-added.show{display:flex}
        .tech-table{background:var(--card);border:1px solid var(--border);border-radius:14px;overflow:hidden}
        .tech-table__row{display:grid;grid-template-columns:160px 1fr;border-bottom:1px solid #f3f4f6;font-size:13px}
        .tech-table__row:last-child{border-bottom:none}
        .tech-table__key{padding:10px 14px;font-weight:700;color:var(--muted);background:#f9fafb;border-right:1px solid #f3f4f6}
        .tech-table__val{padding:10px 14px;color:var(--text)}
        .breadcrumb{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:20px;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:var(--radius)}
        .breadcrumb a{color:var(--muted);text-decoration:none;transition:color .15s}
        .breadcrumb a:hover{color:var(--brand)}
        .breadcrumb span:last-child{color:var(--brand);font-weight:700}
        .breadcrumb__sep{color:#d1d5db;font-weight:400}
        @media(max-width:900px){.product-detail{grid-template-columns:1fr}.product-detail__image{position:static;aspect-ratio:4/3}.product-price{font-size:26px}.add-to-cart{flex-wrap:wrap}.btn-add-cart{width:100%}}
        .product-price__ref { font-size: 12px; color: var(--muted); margin-top: 3px; }
        .stock-pill--err { background: #fff1f2; color: var(--brand); border: 1px solid #fecaca; }
        </style>

    <section style="margin:16px 0 32px">

        <div class="breadcrumb">
            <a href="{{ path('app_home') }}">Inicio</a>
            <span class="breadcrumb__sep">›</span>
            <a href="{{ path('app_catalog') }}">Catálogo</a>
            {% if product.family %}
                <span class="breadcrumb__sep">›</span>
                <a href="{{ path('app_catalog', {family: product.family.id}) }}">{{ product.family.name }}</a>
            {% endif %}
            {% if product.subfamily %}
                <span class="breadcrumb__sep">›</span>
                <a href="{{ path('app_catalog', {code: product.subfamily.code}) }}">{{ product.subfamily.name }}</a>
            {% endif %}
            <span class="breadcrumb__sep">›</span>
            <span>{{ (product.title ?: product.model)|u.truncate(40,'…') }}</span>
        </div>

        <div class="product-detail">

            <div class="product-detail__image">
                {% if product.image %}
                    <img src="{{ product.image }}" alt="{{ product.title ?: product.model }}">
                {% else %}
                    <div class="product-detail__placeholder">
                        <div class="product-detail__placeholder-icon"></div>
                        {% if product.brand %}<span>{{ product.brand }}</span>{% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="product-detail__info">

                {% if product.brand %}
                    <span class="product-brand-badge">{{ product.brand }}</span>
                {% endif %}

                <h1>{{ product.title ?: product.model }}</h1>

                <div class="product-ref">
                    {% if product.family %}{{ product.family.name }}{% endif %}{% if product.subfamily %} / {{ product.subfamily.name }}{% endif %}
                </div>

                <div class="product-price-block">
                    <div>
                        <div class="product-price">{{ product.price|number_format(2,',','.') }} €</div>
                        <div class="product-price__ref">Ref. {{ product.article }}</div>
                    </div>
                    {% if product.stock >= 5 %}
                        <span class="stock-pill stock-pill--ok">Disponible</span>
                    {% elseif product.stock > 0 %}
                        <span class="stock-pill stock-pill--warn">Consultar</span>
                    {% else %}
                        <span class="stock-pill stock-pill--err">Sin stock</span>
                    {% endif %}
                </div>

                <div class="flash-added" id="flashAdded">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    Producto añadido al carrito —
                    <a href="{{ path('app_cart_index') }}" style="color:#15803d;font-weight:800">Ver carrito</a>
                </div>

                <div class="add-to-cart">
                    <div class="qty-select">
                        <button class="qty-select__btn" type="button" id="qtyDec">−</button>
                        <input class="qty-select__input" type="number" id="qtyInput" value="1" min="1" max="999">
                        <button class="qty-select__btn" type="button" id="qtyInc">+</button>
                    </div>
                    <button class="btn-add-cart" type="button" id="btnAddCart"
                            data-url="{{ path('app_cart_add', {article: product.article}) }}">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                            <line x1="3" y1="6" x2="21" y2="6"/>
                            <path d="M16 10a4 4 0 01-8 0"/>
                        </svg>
                        Añadir al carrito
                    </button>
                </div>

                <a class="btn" href="{{ path('app_catalog') }}" style="width:fit-content">← Volver al catálogo</a>

                {% if product.description %}
                    <div>
                        <h3 style="margin:0 0 8px;font-size:15px">Descripción</h3>
                        <p style="margin:0;color:var(--muted);font-size:13px;line-height:1.6">{{ product.description }}</p>
                    </div>
                {% endif %}

                <div class="tech-table">
                    {% if product.ean %}
                        <div class="tech-table__row"><div class="tech-table__key">EAN</div><div class="tech-table__val">{{ product.ean }}</div></div>
                    {% endif %}
                    <div class="tech-table__row"><div class="tech-table__key">Modelo</div><div class="tech-table__val">{{ product.model }}</div></div>

                    {% if product.digitalCanon %}
                        <div class="tech-table__row"><div class="tech-table__key">Canon digital</div><div class="tech-table__val">{{ product.digitalCanon|number_format(2,',','.') }} €</div></div>
                    {% endif %}
                    <div class="tech-table__row"><div class="tech-table__key">Disponibilidad</div><div class="tech-table__val">
                        {% if product.stock >= 5 %}Disponible{% elseif product.stock > 0 %}Consultar{% else %}Sin stock{% endif %}
                    </div></div>
                </div>

            </div>
        </div>
    </section>

    <script>
        (function(){
            const qtyInput = document.getElementById('qtyInput');
            document.getElementById('qtyDec').addEventListener('click',()=>{ qtyInput.value=Math.max(1,parseInt(qtyInput.value,10)-1); });
            document.getElementById('qtyInc').addEventListener('click',()=>{ qtyInput.value=Math.min(999,parseInt(qtyInput.value,10)+1); });

            document.getElementById('btnAddCart').addEventListener('click', async function(){
                const qty=parseInt(qtyInput.value,10)||1;
                this.disabled=true;
                try{
                    const res=await fetch(this.dataset.url,{
                        method:'POST',
                        headers:{'X-Requested-With':'XMLHttpRequest','Content-Type':'application/x-www-form-urlencoded'},
                        body:new URLSearchParams({quantity:qty})
                    });
                    const data=await res.json();
                    // Actualizar badge del header
                    document.querySelectorAll('[data-cart-count]').forEach(el=>{
                        el.textContent=data.count;
                        el.style.display='flex';
                    });
                    // Flash local
                    const flash=document.getElementById('flashAdded');
                    flash.classList.add('show');
                    setTimeout(()=>flash.classList.remove('show'),4000);
                }catch(e){ console.error(e); }
                finally{ this.disabled=false; }
            });
        })();
    </script>
{% endblock %}
