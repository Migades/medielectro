<script>
(function () {
    'use strict';

    var header      = document.getElementById('siteHeader');
    var catalogMega = document.getElementById('catalogMega');
    var overlay     = document.getElementById('catalogOverlay');
    var catalogBtn  = document.getElementById('catalogBtn');
    var servicesBtn = document.getElementById('servicesBtn');
    var servicesMenu= document.getElementById('servicesMenu');

    /* ── Posición dinámica bajo el header sticky ── */
    function headerBottom() {
        return header ? header.getBoundingClientRect().bottom : 0;
    }

    /* ── Mega-menú Catálogo ── */
    function openCatalog() {
        var top = headerBottom();
        catalogMega.style.top = top + 'px';
        if (overlay) { overlay.style.top = top + 'px'; overlay.classList.add('open'); }
        catalogMega.classList.add('open');
        catalogBtn.classList.add('active');
        catalogBtn.setAttribute('aria-expanded', 'true');
    }
    function closeCatalog() {
        catalogMega.classList.remove('open');
        if (overlay) overlay.classList.remove('open');
        catalogBtn.classList.remove('active');
        catalogBtn.setAttribute('aria-expanded', 'false');
    }

    if (catalogBtn) {
        catalogBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            closeServices();
            catalogMega.classList.contains('open') ? closeCatalog() : openCatalog();
        });
    }
    if (overlay) overlay.addEventListener('click', closeCatalog);

    /* ── Familias: cambio de panel ── */
    document.querySelectorAll('.catalog-mega__family').forEach(function (item) {
        item.addEventListener('click', function () {
            var id = item.dataset.family;
            document.querySelectorAll('.catalog-mega__family').forEach(function (f) { f.classList.remove('active'); });
            document.querySelectorAll('.catalog-mega__panel').forEach(function (p) { p.classList.remove('active'); });
            item.classList.add('active');
            var panel = document.querySelector('[data-panel="' + id + '"]');
            if (panel) panel.classList.add('active');
        });
    });

    /* ── Servicios ── */
    function openServices() {
        var rect = servicesBtn.getBoundingClientRect();
        servicesMenu.style.top  = (rect.bottom + 8) + 'px';
        servicesMenu.style.left = (rect.left + rect.width / 2 - 130) + 'px';
        servicesMenu.style.display = 'block';
        servicesBtn.classList.add('active');
        servicesBtn.setAttribute('aria-expanded', 'true');
    }
    function closeServices() {
        if (!servicesMenu) return;
        servicesMenu.style.display = 'none';
        servicesBtn.classList.remove('active');
        servicesBtn.setAttribute('aria-expanded', 'false');
    }

    if (servicesBtn) {
        servicesBtn.addEventListener('click', function (e) {
            e.stopPropagation();
            closeCatalog();
            servicesMenu.style.display === 'block' ? closeServices() : openServices();
        });
    }

    /* ── Click fuera cierra todo ── */
    document.addEventListener('click', function (e) {
        if (!catalogMega.contains(e.target) && e.target !== catalogBtn) closeCatalog();
        if (servicesMenu && !servicesMenu.contains(e.target) && e.target !== servicesBtn) closeServices();
    });

    /* ── Reposicionar al hacer scroll ── */
    window.addEventListener('scroll', function () {
        if (catalogMega.classList.contains('open')) {
            catalogMega.style.top = headerBottom() + 'px';
            if (overlay) overlay.style.top = headerBottom() + 'px';
        }
    }, { passive: true });
})();
</script>
