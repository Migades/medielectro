<script>
(function () {
    'use strict';
    var overlay    = document.getElementById('navOverlay');
    var header     = document.getElementById('siteHeader');
    var closeTimer = null;

    function headerBottom() { return header ? header.getBoundingClientRect().bottom : 0; }

    function closeAll() {
        document.querySelectorAll('[data-mega]').forEach(function(m) { m.classList.remove('is-open'); });
        document.querySelectorAll('[data-nav-btn]').forEach(function(b) { b.classList.remove('is-open'); });
        var svcDrop = document.querySelector('[data-nav-services-drop]');
        var svcBtn  = document.querySelector('[data-nav-services-btn]');
        if (svcDrop) svcDrop.classList.remove('is-open');
        if (svcBtn)  svcBtn.classList.remove('is-open');
        if (overlay) overlay.classList.remove('is-open');
    }
    function scheduleClose() { clearTimeout(closeTimer); closeTimer = setTimeout(closeAll, 150); }
    function cancelClose()   { clearTimeout(closeTimer); }

    document.querySelectorAll('[data-nav-cat]').forEach(function(cat) {
        var key  = cat.getAttribute('data-nav-cat');
        var btn  = cat.querySelector('[data-nav-btn]');
        var mega = document.getElementById('mega-' + key);
        if (!btn || !mega) return;

        function openMega() {
            cancelClose();
            document.querySelectorAll('[data-mega]').forEach(function(m) { m.classList.remove('is-open'); });
            document.querySelectorAll('[data-nav-btn]').forEach(function(b) { b.classList.remove('is-open'); });
            mega.style.top = headerBottom() + 'px';
            mega.classList.add('is-open');
            btn.classList.add('is-open');
            if (overlay) overlay.classList.add('is-open');
        }

        btn.addEventListener('mouseenter', openMega);
        btn.addEventListener('mouseleave', scheduleClose);
        mega.addEventListener('mouseenter', cancelClose);
        mega.addEventListener('mouseleave', scheduleClose);
    });

    var svcWrap = document.querySelector('[data-nav-services]');
    if (svcWrap) {
        var svcBtn  = svcWrap.querySelector('[data-nav-services-btn]');
        var svcDrop = svcWrap.querySelector('[data-nav-services-drop]');
        function openSvc() {
            cancelClose();
            closeAll();
            var rect = svcBtn.getBoundingClientRect();
            svcDrop.style.top   = headerBottom() + 'px';
            svcDrop.style.right = (window.innerWidth - rect.right) + 'px';
            svcDrop.style.left  = 'auto';
            svcDrop.classList.add('is-open');
            svcBtn.classList.add('is-open');
        }
        svcBtn.addEventListener('mouseenter', openSvc);
        svcBtn.addEventListener('mouseleave', scheduleClose);
        svcDrop.addEventListener('mouseenter', cancelClose);
        svcDrop.addEventListener('mouseleave', scheduleClose);
    }

        if (overlay) overlay.addEventListener('click', closeAll);
        document.addEventListener('click', function(e) {
            if (!e.target.closest('[data-nav-cat]') && !e.target.closest('[data-mega]') && !e.target.closest('[data-nav-services]')) closeAll();
        });
        window.addEventListener('scroll', closeAll, { passive: true });
})();
</script>

    <!-- Banner de cookies -->
    <div id="cookieBanner" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:9999; background:#1e293b; color:#f8fafc; padding:18px 24px; box-shadow:0 -4px 24px rgba(0,0,0,.18);">
        <div style="max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;">
            <p style="margin:0; font-size:14px; line-height:1.6; flex:1; min-width:220px;">
                Usamos cookies propias y de terceros (Google Analytics) para analizar el uso de la web y mejorar tu experiencia.
                <a href="/legal/cookies" style="color:#e30613; text-decoration:underline;">Política de cookies</a>
            </p>
            <div style="display:flex; gap:10px; flex-shrink:0;">
                <button id="cookieReject" style="background:transparent; color:#94a3b8; border:1.5px solid #475569; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit;">Solo necesarias</button>
                <button id="cookieAccept" style="background:#e30613; color:#fff; border:none; border-radius:8px; padding:9px 18px; font-size:13px; font-weight:700; cursor:pointer; font-family:inherit;">Aceptar todas</button>
            </div>
        </div>
    </div>

    <script>
        (function() {
            var consent = localStorage.getItem('medielectro_cookies');

            function loadGA() {
                gtag('consent', 'update', { 'analytics_storage': 'granted' });
            }

            if (consent === 'accepted') {
                loadGA();
            } else if (consent === null) {
                document.getElementById('cookieBanner').style.display = 'block';
            }

            document.getElementById('cookieAccept').addEventListener('click', function() {
                localStorage.setItem('medielectro_cookies', 'accepted');
                document.getElementById('cookieBanner').style.display = 'none';
                loadGA();
            });

            document.getElementById('cookieReject').addEventListener('click', function() {
                localStorage.setItem('medielectro_cookies', 'rejected');
                document.getElementById('cookieBanner').style.display = 'none';
            });
        })();
    </script>
</body>
</html>
