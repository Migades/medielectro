<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Medielectro{% endblock %}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/app.css">
    <style>
        .header {
            position: sticky;
            top: 0;
            z-index: 10000;
            background: white;
        }
        .cart-btn {
            position: relative;
            display: inline-flex; align-items: center; justify-content: center;
            width: 44px; height: 44px;
            border: 1px solid var(--border);
            background: var(--card);
            border-radius: 999px;
            color: var(--text);
            text-decoration: none;
            transition: background .15s;
            flex-shrink: 0;
        }
        .cart-btn:hover { background: #f3f4f6; }
        .cart-badge {
            position: absolute;
            top: -4px; right: -4px;
            min-width: 18px; height: 18px;
            background: var(--brand);
            color: white;
            border-radius: 999px;
            font-size: 10px; font-weight: 800;
            display: flex; align-items: center; justify-content: center;
            padding: 0 4px;
            border: 2px solid white;
        }
        .cart-btn-main {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: var(--brand);
            color: white;
            border-radius: 50px;
            padding: 6px 20px 6px 8px;
            text-decoration: none;
            transition: opacity .15s;
            white-space: nowrap;
        }
        .cart-btn-main:hover { opacity: .88; }
        .cart-btn-main__icon {
            position: relative;
            flex-shrink: 0;
            width: 32px;
            height: 32px;
            background: rgba(255,255,255,.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .cart-btn-main__badge {
            position: absolute;
            top: -4px;
            right: -4px;
            min-width: 16px;
            height: 16px;
            background: white;
            color: var(--brand);
            border-radius: 999px;
            font-size: 9px;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
        }
        .cart-btn-main__label {
            font-size: 13px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
        }
        .nav { position: relative; }
        .nav-cat { position: static; display: inline-block; }
        .nav-cat__btn {
            display: inline-flex; align-items: center; gap: 4px;
            background: none; border: none; cursor: pointer;
            font-size: 13px; font-weight: 600; color: var(--muted);
            padding: 8px 10px; border-radius: 8px;
            font-family: inherit; line-height: 1;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .nav-cat__btn:hover,
        .nav-cat__btn.is-open { background: #f3f4f6; color: var(--text); }
        .nav-cat__btn svg { transition: transform .2s; flex-shrink: 0; opacity: .5; }
        .nav-cat__btn.is-open svg { transform: rotate(180deg); opacity: 1; }

        /* ── Mega menú ── */
        .nav-mega {
            display: none;
            position: fixed;
            left: 0; right: 0;
            z-index: 99999;
            background: white;
            border-top: 3px solid var(--brand);
            border-bottom: 1px solid #e5e7eb;
            box-shadow: 0 12px 40px rgba(17,24,39,.13);
            padding: 28px 0 32px;
        }
        .nav-mega.is-open { display: block; }

        .nav-mega__inner {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 32px;
        }

        .nav-mega__heading {
            font-size: 18px;
            font-weight: 900;
            letter-spacing: -.3px;
            color: var(--text);
            margin: 0 0 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid #f3f4f6;
        }

        .nav-mega__cols {
            display: flex;
            gap: 0;
            align-items: flex-start;
            justify-content: space-between;
            width: 100%;
        }

        .nav-mega__col {
            flex: 1;
            padding: 0 20px;
            min-width: 0;
        }
        .nav-mega__col:first-child { padding-left: 0; }
        .nav-mega__col:last-child  { padding-right: 0; }

        .nav-mega__col-title--link {
            text-decoration: none;
            cursor: pointer;
        }
        .nav-mega__col-title--link:hover {
            opacity: .75;
        }
        .nav-mega__col-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--brand);
            margin: 0 0 8px;
            display: block;
        }

        .nav-mega__sub {
            display: block;
            padding: 4px 0;
            font-size: 13px;
            color: #374151;
            text-decoration: none;
            transition: color .1s;
            line-height: 1.5;
        }
        .nav-mega__sub:hover { color: var(--brand); }

        .nav-mega__sub--brand { font-weight: 600; color: #111827; }

        .nav-mega__see-all {
            display: inline-block;
            margin-top: 18px;
            font-size: 12px;
            font-weight: 800;
            color: var(--brand);
            text-decoration: none;
        }
        .nav-mega__see-all:hover { text-decoration: underline; }

        .nav-mega-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9998;
            background: rgba(0,0,0,.18);
        }
        .nav-mega-overlay.is-open { display: block; }

        /* ── Servicios ── */
        .nav-services { position: static; display: inline-block; }
        .nav-services__btn {
            display: inline-flex; align-items: center; gap: 4px;
            background: none; border: none; cursor: pointer;
            font-size: 13px; font-weight: 600; color: var(--muted);
            padding: 8px 10px; border-radius: 8px;
            font-family: inherit; line-height: 1;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .nav-services__btn:hover,
        .nav-services__btn.is-open { background: #f3f4f6; color: var(--text); }
        .nav-services__dropdown {
            display: none;
            position: fixed;
            z-index: 99999;
            background: white;
            border: 1px solid #e5e7eb;
            border-top: 3px solid var(--brand);
            box-shadow: 0 12px 40px rgba(17,24,39,.13);
            padding: 8px;
            min-width: 260px;
        }
        .nav-services__dropdown.is-open { display: block; }
        .services-menu__item {
            display: flex; align-items: center; gap: 14px;
            padding: 12px 14px; border-radius: 10px;
            text-decoration: none; color: #111827;
            transition: background .15s;
        }
        .services-menu__item:hover { background: #f9fafb; }
        .services-menu__item svg { flex-shrink: 0; color: var(--muted); }
        .services-menu__label { font-size: 13px; font-weight: 700; }
        .services-menu__sub { font-size: 11px; color: #6b7280; margin-top: 2px; }

        .nav-link {
            font-size: 13px; font-weight: 600; color: var(--muted);
            padding: 8px 10px; border-radius: 8px;
            text-decoration: none;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .nav-link:hover { background: #f3f4f6; color: var(--text); }
    </style>

    <!-- Google Analytics 4 - carga solo con consentimiento -->
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('consent', 'default', {
            'analytics_storage': 'denied'
        });
        gtag('js', new Date());
        gtag('config', 'G-74PTX4E8B1');
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-74PTX4E8B1"></script>
</head>
<body>

<div class="nav-mega-overlay" id="navOverlay"></div>

<header class="header" id="siteHeader">
    <div class="container">
        <div class="header-top">
            <a class="logo" href="{{ path('app_home') }}">
                <img class="logo-img" src="/assets/logo1-mediaelectro.webp" alt="Medielectro">
            </a>
            <form class="search" action="{{ path('app_catalog') }}" method="get">
                <span style="color:var(--muted)"></span>
                <input name="q" value="{{ app.request.query.get('q') }}" placeholder="Buscar por artículo, modelo, marca o descripción…">
            </form>
            <div class="header-actions">
                <span class="pill">96 350 16 75</span>
                {% set cartItems = app.session.get('cart') ?? [] %}
                {% set cartCount = 0 %}
                {% for item in cartItems %}{% set cartCount = cartCount + item.quantity %}{% endfor %}
                <a class="cart-btn-main" href="{{ path('app_cart_index') }}" title="Ver carrito">
                    <div class="cart-btn-main__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                            <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/>
                        </svg>
                        <span class="cart-btn-main__badge" data-cart-count style="{{ cartCount == 0 ? 'display:none' : '' }}">{{ cartCount }}</span>
                    </div>
                    <span class="cart-btn-main__label">Mi carrito</span>
                </a>
            </div>
        </div>

        <nav class="nav">
            <div class="nav-cat" data-nav-cat="electrodomesticos"><button class="nav-cat__btn" data-nav-btn>Electrodomésticos <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></button></div>
            <div class="nav-cat" data-nav-cat="climatizacion"><button class="nav-cat__btn" data-nav-btn>Climatización <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></button></div>
            <div class="nav-cat" data-nav-cat="calefaccion"><button class="nav-cat__btn" data-nav-btn>Calefacción <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></button></div>
            <div class="nav-cat" data-nav-cat="tv"><button class="nav-cat__btn" data-nav-btn>TV y Sonido <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></button></div>
            <div class="nav-cat" data-nav-cat="pequenos"><button class="nav-cat__btn" data-nav-btn>Pequeños Electrodomésticos <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg></button></div>
            <a class="nav-link" href="{{ path('app_catalog', {code: 'VEN'}) }}">Ventilación</a>
        </nav>
    </div>
</header>

