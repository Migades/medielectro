<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Medielectro{% endblock %}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/app.css">
    <style>
        .cart-btn {
            position: relative;
            display: inline-flex; align-items: center; justify-content: center;
            width: 44px; height: 44px;
            border: 1px solid var(--border);
            background: var(--card);
            border-radius: 999px;
            color: var(--text);
            text-decoration: none;
            transition: background .15s;
            flex-shrink: 0;
        }
        .cart-btn:hover { background: #f3f4f6; }
        .cart-badge {
            position: absolute;
            top: -4px; right: -4px;
            min-width: 18px; height: 18px;
            background: var(--brand);
            color: white;
            border-radius: 999px;
            font-size: 10px; font-weight: 800;
            display: flex; align-items: center; justify-content: center;
            padding: 0 4px;
            border: 2px solid white;
        }

        /* ── Dropdown Servicios ── */
        .nav-dropdown { position: relative; display: flex; align-items: center; }

        .nav-dropdown__trigger {
            display: inline-flex; align-items: center; gap: 5px;
            background: none; border: none; cursor: pointer;
            font-size: 15px; font-weight: 700; color: var(--text);
            padding: 10px 12px; border-radius: 999px;
            font-family: inherit; line-height: 1;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .nav-dropdown__trigger:hover { background: #f3f4f6; color: var(--text); }
        .nav-dropdown.open .nav-dropdown__trigger { background: #f3f4f6; color: var(--brand); }
        .nav-dropdown__trigger svg { transition: transform .2s; }
        .nav-dropdown.open .nav-dropdown__trigger svg { transform: rotate(180deg); }

        .nav-dropdown__menu {
            position: absolute;
            top: calc(100% + 10px);
            left: 50%; transform: translateX(-50%);
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 16px 48px rgba(17,24,39,.14);
            min-width: 270px; padding: 8px;
            opacity: 0; visibility: hidden;
            transform: translateX(-50%) translateY(-6px);
            transition: opacity .18s, transform .18s, visibility .18s;
            z-index: 9999;
            pointer-events: none;
        }

        .nav-dropdown.open .nav-dropdown__menu {
            opacity: 1; visibility: visible;
            transform: translateX(-50%) translateY(0);
            pointer-events: auto;
        }

        .nav-dropdown__item {
            display: flex; align-items: center; gap: 14px;
            padding: 12px 14px; border-radius: 10px;
            text-decoration: none; color: #111827;
            transition: background .15s;
        }
        .nav-dropdown__item:hover { background: #f9fafb; }
        .nav-dropdown__icon { font-size: 24px; flex-shrink: 0; }
        .nav-dropdown__item-title { font-size: 13px; font-weight: 700; }
        .nav-dropdown__item-sub { font-size: 11px; color: #6b7280; margin-top: 2px; }
    </style>
</head>
<body>
<header class="header">
    <div class="container">
        <div class="header-top">
            <a class="logo" href="{{ path('app_home') }}">
                <img class="logo-img" src="/assets/logo1-mediaelectro.webp" alt="Medielectro">
            </a>

            <form class="search" action="{{ path('app_catalog') }}" method="get">
                <span style="color:var(--muted)"></span>
                <input name="q" value="{{ app.request.query.get('q') }}" placeholder="Buscar por artículo, modelo, marca o descripción…">
            </form>

            <div class="header-actions">
                <span class="pill">📞 96 350 16 75</span>

                {# Icono carrito con badge — count calculado desde sesión #}
                {% set cartItems = app.session.get('cart') ?? [] %}
                {% set cartCount = 0 %}
                {% for item in cartItems %}{% set cartCount = cartCount + item.quantity %}{% endfor %}

                <a class="cart-btn" href="{{ path('app_cart_index') }}" title="Ver carrito">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                    <span class="cart-badge" data-cart-count style="{{ cartCount == 0 ? 'display:none' : '' }}">{{ cartCount }}</span>
                </a>

                <a class="btn btn-primary" href="#contacto">Pedir presupuesto</a>
            </div>
        </div>

        <nav class="nav">
            <a href="{{ path('app_home') }}">Inicio</a>
            <a href="{{ path('app_catalog') }}">Catálogo</a>
            <div class="nav-dropdown" id="servicesDropdown">
                <button class="nav-dropdown__trigger" id="servicesBtn">
                    Servicios
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
            </div>

            {# Menú fuera del nav para evitar clipping #}
            <div id="servicesMenu" style="
                position:fixed;
                display:none;
                background:white;
                border:1px solid #e5e7eb;
                border-radius:14px;
                box-shadow:0 16px 48px rgba(17,24,39,.18);
                padding:8px;
                min-width:270px;
                z-index:99999;
            ">
                <a style="display:flex;align-items:center;gap:14px;padding:12px 14px;border-radius:10px;text-decoration:none;color:#111827;" href="{{ path('app_service_reparacion') }}" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='transparent'">
                    <span style="font-size:24px">🔧</span>
                    <div>
                        <div style="font-size:13px;font-weight:700">Reparación</div>
                        <div style="font-size:11px;color:#6b7280;margin-top:2px">Servicio técnico y diagnóstico</div>
                    </div>
                </a>
                <a style="display:flex;align-items:center;gap:14px;padding:12px 14px;border-radius:10px;text-decoration:none;color:#111827;" href="{{ path('app_service_instalacion') }}" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='transparent'">
                    <span style="font-size:24px">🔌</span>
                    <div>
                        <div style="font-size:13px;font-weight:700">Instalación</div>
                        <div style="font-size:11px;color:#6b7280;margin-top:2px">Instalación profesional a domicilio</div>
                    </div>
                </a>
            </div>
            <a href="#contacto">Contacto</a>
        </nav>
    </div>
</header>

<main class="container">
    {% block body %}{% endblock %}
</main>

<footer class="footer-v2" id="contacto">
    <div class="container">

        <div class="footer-v2__top">

            {# Columna 1 — Marca y contacto #}
            <div class="footer-col footer-col__brand">
                <div class="footer-col__logo">medielectro.es</div>
                <p class="footer-col__desc">
                    Especialistas en electrodomésticos, repuestos y servicio técnico en Valencia.
                    Venta, reparación e instalación con atención personalizada.
                </p>
                <div class="footer-col__contact">
                    <a href="tel:963501675">96 350 16 75</a>
                    <a href="mailto:info@medielectro.es">info@medielectro.es</a>
                    <a href="#">C/ Lorem Ipsum, 12 · Valencia</a>
                </div>
                <div class="footer-col__hours">
                    Lunes a viernes: 9:00 – 14:00 y 16:00 – 19:30<br>
                    Sábados: 9:00 – 13:30
                </div>
            </div>

            {# Columna 2 — Tienda #}
            <div class="footer-col">
                <h4>Tienda</h4>
                <ul>
                    <li><a href="{{ path('app_catalog') }}">Catálogo de productos</a></li>
                    <li><a href="{{ path('app_catalog', {inStock: 1}) }}">Productos disponibles</a></li>
                    <li><a href="{{ path('app_catalog', {brand: 'BOSCH'}) }}">Bosch</a></li>
                    <li><a href="{{ path('app_catalog', {brand: 'BALAY'}) }}">Balay</a></li>
                    <li><a href="{{ path('app_catalog', {brand: 'SAMSUNG'}) }}">Samsung</a></li>
                    <li><a href="{{ path('app_cart_index') }}">Mi carrito</a></li>
                </ul>
            </div>

            {# Columna 3 — Servicios #}
            <div class="footer-col">
                <h4>Servicios</h4>
                <ul>
                    <li><a href="{{ path('app_service_reparacion') }}">Reparación de electrodomésticos</a></li>
                    <li><a href="{{ path('app_service_instalacion') }}">Instalación a domicilio</a></li>
                    <li><a href="#">Presupuesto sin compromiso</a></li>
                    <li><a href="#">Servicio técnico oficial</a></li>
                    <li><a href="#contacto">Contacto</a></li>
                </ul>
            </div>

            {# Columna 4 — Información #}
            <div class="footer-col">
                <h4>Información</h4>
                <ul>
                    <li><a href="#">Aviso legal</a></li>
                    <li><a href="#">Política de privacidad</a></li>
                    <li><a href="#">Política de cookies</a></li>
                    <li><a href="#">Condiciones de venta</a></li>
                    <li><a href="#">Política de devoluciones</a></li>
                </ul>
            </div>

        </div>

        <div class="footer-v2__bottom">
            <span>© {{ "now"|date("Y") }} Medielectro · Todos los derechos reservados</span>
            <div class="footer-v2__legal">
                <a href="#">Aviso legal</a>
                <a href="#">Privacidad</a>
                <a href="#">Cookies</a>
            </div>
        </div>

    </div>
</footer>
<script>
    (function() {
        var btn  = document.getElementById('servicesBtn');
        var menu = document.getElementById('servicesMenu');
        var wrap = document.getElementById('servicesDropdown');
        if (!btn || !menu) return;

        function openMenu() {
            var rect = btn.getBoundingClientRect();
            menu.style.top  = (rect.bottom + 8) + 'px';
            menu.style.left = (rect.left + rect.width / 2 - 135) + 'px';
            menu.style.display = 'block';
            wrap.classList.add('open');
        }

        function closeMenu() {
            menu.style.display = 'none';
            wrap.classList.remove('open');
        }

        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            menu.style.display === 'block' ? closeMenu() : openMenu();
        });

        document.addEventListener('click', function(e) {
            if (!menu.contains(e.target)) closeMenu();
        });
    })();
</script>
</body>
</html>
