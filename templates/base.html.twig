<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Medielectro{% endblock %}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/app.css">
    <style>
        /* ── Carrito badge ── */
        .cart-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px; height: 42px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--card);
            color: var(--text);
            text-decoration: none;
            transition: border-color .15s, box-shadow .15s;
            flex-shrink: 0;
        }

        .cart-btn:hover { border-color: var(--brand); box-shadow: 0 2px 8px rgba(227,6,19,.12); }

        .cart-badge {
            position: absolute;
            top: -6px; right: -6px;
            min-width: 18px; height: 18px;
            background: var(--brand);
            color: white;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            border: 2px solid var(--bg);
        }
    </style>
</head>
<body>
<header class="header">
    <div class="container">
        <div class="header-top">
            <a class="logo" href="{{ path('app_home') }}">
                <img class="logo-img" src="/assets/logo1-mediaelectro.webp" alt="Medielectro">
            </a>

            <form class="search" action="{{ path('app_catalog') }}" method="get">
                <input name="q" value="{{ app.request.query.get('q') }}" placeholder="Buscar por artículo, modelo, marca o descripción…">
            </form>

            <div class="header-actions">
                <span class="pill">📞 96 350 16 75</span>

                {# Mini-carrito — badge con nº de items en sesión #}
                {% set cartCount = app.session.get('cart')|default([])|length %}
                <a class="cart-btn" href="{{ path('app_cart_index') }}" title="Carrito">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                    <span class="cart-badge" id="cartBadge" {% if cartCount == 0 %}style="display:none"{% endif %}>
                        {{ cartCount }}
                    </span>
                </a>

                <a class="btn btn-primary" href="#contacto">Pedir presupuesto</a>
            </div>
        </div>

        <nav class="nav">
            <a href="{{ path('app_home') }}">Inicio</a>
            <a href="{{ path('app_catalog') }}">Catálogo</a>
            <a href="#">Reparación</a>
            <a href="#">Instalación</a>
            <a href="#">Servicios</a>
            <a href="#contacto">Contacto</a>
        </nav>
    </div>
</header>

<main class="container">
    {% block body %}{% endblock %}
</main>

<footer class="footer" id="contacto">
    <div class="container" style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap;">
        <div>
            <strong style="color:var(--text)">Medielectro</strong><br>
            Electricidad y reparación de electrodomésticos · Valencia
        </div>
        <div>
            <div>info@medielectro.es</div>
            <div>96 350 16 75</div>
        </div>
        <div>
            <a href="#" style="margin-right:10px;">Aviso legal</a>
            <a href="#" style="margin-right:10px;">Privacidad</a>
            <a href="#">Cookies</a>
        </div>
    </div>
</footer>
</body>
</html>
