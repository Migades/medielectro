<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Medielectro{% endblock %}</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="stylesheet" href="/assets/app.css">
    <style>
        .cart-btn {
            position: relative;
            display: inline-flex; align-items: center; justify-content: center;
            width: 44px; height: 44px;
            border: 1px solid var(--border);
            background: var(--card);
            border-radius: 999px;
            color: var(--text);
            text-decoration: none;
            transition: background .15s;
            flex-shrink: 0;
        }
        .cart-btn:hover { background: #f3f4f6; }
        .cart-badge {
            position: absolute;
            top: -4px; right: -4px;
            min-width: 18px; height: 18px;
            background: var(--brand);
            color: white;
            border-radius: 999px;
            font-size: 10px; font-weight: 800;
            display: flex; align-items: center; justify-content: center;
            padding: 0 4px;
            border: 2px solid white;
        }

        /* ── Trigger genérico (Catálogo y Servicios) — idéntico a .nav a ── */
        .nav-trigger {
            display: inline-flex; align-items: center; gap: 4px;
            background: none; border: none; cursor: pointer;
            font-size: 13px; font-weight: 700; color: var(--muted);
            padding: 8px 10px; border-radius: 999px;
            font-family: inherit; line-height: 1;
            transition: background .15s, color .15s;
            white-space: nowrap;
        }
        .nav-trigger:hover { background: #f3f4f6; color: var(--text); }
        .nav-trigger.active { background: #f3f4f6; color: var(--brand); }
        .nav-trigger svg { transition: transform .2s; flex-shrink: 0; }
        .nav-trigger.active svg { transform: rotate(180deg); }

        /* ── Menú Servicios ── */
        .services-menu {
            position: fixed;
            display: none;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 16px 48px rgba(17,24,39,.18);
            padding: 8px;
            min-width: 260px;
            z-index: 99999;
        }
        .services-menu__item {
            display: flex; align-items: center; gap: 14px;
            padding: 12px 14px; border-radius: 10px;
            text-decoration: none; color: #111827;
            transition: background .15s;
        }
        .services-menu__item:hover { background: #f9fafb; }
        .services-menu__item svg { flex-shrink: 0; color: var(--muted); }
        .services-menu__label { font-size: 13px; font-weight: 700; }
        .services-menu__sub { font-size: 11px; color: #6b7280; margin-top: 2px; }

        /* ── Mega-menú Catálogo ── */
        .catalog-mega-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9997;
            background: rgba(0,0,0,.22);
        }
        .catalog-mega-overlay.open { display: block; }

        .catalog-mega {
            display: none;
            position: fixed;
            left: 0; right: 0;
            z-index: 9998;
            background: white;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 20px 60px rgba(17,24,39,.14);
        }
        .catalog-mega.open { display: block; }

        .catalog-mega__inner {
            display: grid;
            grid-template-columns: 220px 1fr;
            max-height: 500px;
        }

        .catalog-mega__sidebar {
            border-right: 1px solid var(--border);
            overflow-y: auto;
            padding: 14px 0;
            background: #fafafa;
        }
        .catalog-mega__sidebar-title {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--muted);
            padding: 0 16px 10px;
        }
        .catalog-mega__family {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text);
            cursor: pointer;
            border-left: 2px solid transparent;
            transition: background .1s, color .1s;
        }
        .catalog-mega__family:hover { background: #f3f4f6; }
        .catalog-mega__family.active {
            background: white;
            color: var(--brand);
            border-left-color: var(--brand);
            font-weight: 700;
        }
        .catalog-mega__family svg { opacity: .3; flex-shrink: 0; }
        .catalog-mega__family.active svg { opacity: .7; }

        .catalog-mega__main {
            overflow-y: auto;
            padding: 20px 28px;
        }
        .catalog-mega__panel { display: none; }
        .catalog-mega__panel.active { display: block; }

        .catalog-mega__groups {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px 28px;
        }
        .catalog-mega__group-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: var(--muted);
            margin: 0 0 8px;
            padding-bottom: 6px;
            border-bottom: 1px solid var(--border);
        }
        .catalog-mega__subs {
            display: flex;
            flex-direction: column;
            gap: 0;
        }
        .catalog-mega__sub {
            display: block;
            padding: 9px 12px;
            font-size: 13px;
            color: var(--text);
            border-radius: 8px;
            text-decoration: none;
            line-height: 1.4;
            transition: background .1s, color .1s;
        }
        .catalog-mega__sub:hover { background: #f3f4f6; color: var(--brand); }

        .catalog-mega__empty {
            font-size: 13px;
            color: var(--muted);
        }
        .catalog-mega__see-all {
            display: inline-block;
            margin-top: 16px;
            padding-top: 14px;
            border-top: 1px solid var(--border);
            width: 100%;
            font-size: 13px;
            font-weight: 700;
            color: var(--brand);
            text-decoration: none;
        }
        .catalog-mega__see-all:hover { text-decoration: underline; }

        @media (max-width: 860px) {
            .catalog-mega__inner { grid-template-columns: 1fr; }
            .catalog-mega__sidebar { border-right: none; border-bottom: 1px solid var(--border); max-height: 160px; }
            .catalog-mega__groups { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
<header class="header" id="siteHeader">
    <div class="container">
        <div class="header-top">
            <a class="logo" href="{{ path('app_home') }}">
                <img class="logo-img" src="/assets/logo1-mediaelectro.webp" alt="Medielectro">
            </a>

            <form class="search" action="{{ path('app_catalog') }}" method="get">
                <span style="color:var(--muted)"></span>
                <input name="q" value="{{ app.request.query.get('q') }}" placeholder="Buscar por artículo, modelo, marca o descripción…">
            </form>

            <div class="header-actions">
                <span class="pill">96 350 16 75</span>

                {% set cartItems = app.session.get('cart') ?? [] %}
                {% set cartCount = 0 %}
                {% for item in cartItems %}{% set cartCount = cartCount + item.quantity %}{% endfor %}

                <a class="cart-btn" href="{{ path('app_cart_index') }}" title="Ver carrito">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 01-8 0"/>
                    </svg>
                    <span class="cart-badge" data-cart-count style="{{ cartCount == 0 ? 'display:none' : '' }}">{{ cartCount }}</span>
                </a>

                <a class="btn btn-primary" href="#contacto">Pedir presupuesto</a>
            </div>
        </div>

        <nav class="nav">
            <a href="{{ path('app_home') }}">Inicio</a>

            <button class="nav-trigger" id="catalogBtn" aria-expanded="false" aria-controls="catalogMega">
                Catálogo
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>

            <button class="nav-trigger" id="servicesBtn" aria-expanded="false" aria-controls="servicesMenu">
                Servicios
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>

            <a href="#contacto">Contacto</a>
        </nav>
    </div>
</header>

{# ── Overlay y Mega-menú Catálogo (estructura basada en catalog.json) ── #}
