{% extends 'base.html.twig' %}
{% block title %}Medielectro — Electrodomésticos, repuestos y servicio técnico{% endblock %}

{% block body %}
    <style>
        /* ════════════════════════════════════════
           HOME — layout y componentes
           ════════════════════════════════════════ */

        /* ── Hero full-width ── */
        .home-hero {
            /* Rompe el container para ir a ancho completo */
            margin: 16px -16px 0;
            line-height: 0;
            overflow: hidden;
        }

        .home-hero img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* ── Trust strip ── */
        .trust-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: var(--border);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            margin: 16px 0 28px;
        }

        .trust-item {
            background: var(--card);
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 18px;
        }

        .trust-item__icon {
            font-size: 24px;
            flex-shrink: 0;
            width: 40px;
            text-align: center;
        }

        .trust-item__title {
            font-size: 13px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.2;
        }

        .trust-item__sub {
            font-size: 11px;
            color: var(--muted);
            margin-top: 2px;
        }

        /* ── Sección wrapper ── */
        .home-section { margin: 0 0 32px; }

        .home-section__header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 14px;
            gap: 12px;
        }

        .home-section__header h2 {
            margin: 0 0 3px;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -.3px;
        }

        .home-section__header p {
            margin: 0;
            font-size: 13px;
            color: var(--muted);
        }

        /* ── Categorías — scroll horizontal en móvil ── */
        .category-strip {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 10px;
        }

        .category-chip {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 14px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            text-align: center;
            text-decoration: none;
            color: inherit;
            transition: box-shadow .18s, transform .18s, border-color .18s;
        }

        .category-chip:hover {
            box-shadow: 0 6px 18px rgba(17,24,39,.08);
            transform: translateY(-2px);
            border-color: var(--brand);
        }

        .category-chip__icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #fff1f2;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
        }

        .category-chip__name {
            font-size: 11px;
            font-weight: 700;
            line-height: 1.2;
            color: var(--text);
        }

        /* ── Productos destacados ── */
        .featured-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .featured-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            text-decoration: none;
            color: inherit;
            transition: box-shadow .18s, transform .18s;
        }

        .featured-card:hover {
            box-shadow: 0 8px 24px rgba(17,24,39,.10);
            transform: translateY(-2px);
        }

        .featured-card__img {
            width: 100%;
            aspect-ratio: 1/1;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-bottom: 1px solid var(--border);
            position: relative;
        }

        .featured-card__img img { width: 100%; height: 100%; object-fit: cover; }

        .featured-card__placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: #c8d0da;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .featured-card__placeholder-icon { font-size: 30px; opacity: .45; }

        /* Badge stock sobre imagen */
        .stock-badge {
            position: absolute;
            top: 8px; right: 8px;
            font-size: 10px; font-weight: 700;
            padding: 3px 8px; border-radius: 999px;
        }
        .stock-badge--ok   { background: #effbf3; color: #15803d; border: 1px solid #b7ebc6; }
        .stock-badge--warn { background: #fff7ea; color: #92400e; border: 1px solid #ffe2b5; }

        .featured-card__body { padding: 10px 12px; display: flex; flex-direction: column; gap: 3px; flex: 1; }

        .featured-card__brand {
            font-size: 10px; font-weight: 800;
            text-transform: uppercase; letter-spacing: .5px;
            color: var(--muted);
        }

        .featured-card__title {
            font-size: 13px; font-weight: 700;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .featured-card__family { font-size: 11px; color: var(--muted); }

        .featured-card__footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 12px 10px;
            border-top: 1px solid #f3f4f6;
        }

        .featured-card__price { font-size: 16px; font-weight: 900; letter-spacing: -.3px; }
        .featured-card__cta   { font-size: 12px; font-weight: 700; color: var(--brand); }

        /* ── Banner promocional ── */
        .promo-banner {
            border-radius: 18px;
            overflow: hidden;
            background: linear-gradient(135deg, var(--brand) 0%, #a50010 100%);
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            gap: 24px;
            padding: 28px 36px;
            margin-bottom: 32px;
            color: white;
            position: relative;
        }

        /* Patrón decorativo fondo */
        .promo-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 80% 50%, rgba(255,255,255,.08) 0%, transparent 50%),
                radial-gradient(circle at 20% 80%, rgba(0,0,0,.1) 0%, transparent 40%);
            pointer-events: none;
        }

        .promo-banner__eyebrow {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .6px;
            opacity: .8;
            margin-bottom: 6px;
        }

        .promo-banner h2 {
            margin: 0 0 8px;
            font-size: 26px;
            line-height: 1.1;
            letter-spacing: -.5px;
        }

        .promo-banner p {
            margin: 0;
            font-size: 14px;
            opacity: .85;
        }

        .promo-banner__action {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 24px;
            background: white;
            color: var(--brand);
            border-radius: 12px;
            font-weight: 800;
            font-size: 14px;
            text-decoration: none;
            white-space: nowrap;
            transition: opacity .15s;
            position: relative;
            z-index: 1;
        }

        .promo-banner__action:hover { opacity: .88; }

        /* ── Marcas ── */
        .brands-strip {
            display: flex;
            align-items: center;
            gap: 0;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }

        .brand-item {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 18px 12px;
            border-right: 1px solid var(--border);
            font-size: 13px;
            font-weight: 900;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--muted);
            text-decoration: none;
            transition: background .15s, color .15s;
        }

        .brand-item:last-child { border-right: none; }
        .brand-item:hover { background: #f9fafb; color: var(--text); }

        /* ── Servicios ── */
        .services-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .service-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 22px;
            display: flex;
            gap: 16px;
            align-items: flex-start;
            transition: box-shadow .18s;
        }

        .service-card:hover { box-shadow: 0 6px 20px rgba(17,24,39,.07); }

        .service-card__icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            background: #fff1f2;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
            flex-shrink: 0;
        }

        .service-card h3 { margin: 0 0 6px; font-size: 15px; font-weight: 800; }
        .service-card p  { margin: 0; font-size: 13px; color: var(--muted); line-height: 1.5; }

        /* ── CTA banner ── */
        .cta-banner {
            background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
            border-radius: 20px;
            padding: 32px 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
            color: white;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }

        .cta-banner::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(227,6,19,.15), transparent 45%);
            pointer-events: none;
        }

        .cta-banner__tag {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 999px;
            background: rgba(255,255,255,.1);
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .4px;
            margin-bottom: 10px;
        }

        .cta-banner h2 {
            margin: 0 0 8px;
            font-size: 26px;
            line-height: 1.1;
            letter-spacing: -.4px;
            position: relative;
        }

        .cta-banner p { margin: 0; color: rgba(255,255,255,.65); font-size: 14px; position: relative; }

        .cta-banner__actions { display: flex; gap: 10px; flex-shrink: 0; flex-wrap: wrap; position: relative; }

        .cta-banner .btn {
            border-color: rgba(255,255,255,.2);
            background: rgba(255,255,255,.1);
            color: white;
        }

        /* ── Últimas incorporaciones ── */
        .latest-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .latest-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 14px;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            gap: 5px;
            transition: box-shadow .15s, transform .15s;
        }

        .latest-card:hover {
            box-shadow: 0 6px 18px rgba(17,24,39,.08);
            transform: translateY(-2px);
        }

        .latest-card__brand  { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .4px; color: var(--muted); }
        .latest-card__title  { font-size: 13px; font-weight: 700; line-height: 1.3; }
        .latest-card__family { font-size: 11px; color: var(--muted); }
        .latest-card__price  { font-size: 15px; font-weight: 900; letter-spacing: -.3px; margin-top: 6px; color: var(--text); }

        /* ── Responsive ── */
        @media (max-width: 1100px) {
            .category-strip { grid-template-columns: repeat(4, 1fr); }
            .featured-grid  { grid-template-columns: repeat(2, 1fr); }
            .latest-grid    { grid-template-columns: repeat(2, 1fr); }
            .trust-strip    { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .category-strip  { grid-template-columns: repeat(4, 1fr); }
            .services-grid   { grid-template-columns: 1fr; }
            .promo-banner    { grid-template-columns: 1fr; }
            .cta-banner      { flex-direction: column; align-items: flex-start; padding: 24px; }
            .cta-banner h2   { font-size: 20px; }
            .brands-strip    { flex-wrap: wrap; }
            .brand-item      { flex: 0 0 33.33%; border-bottom: 1px solid var(--border); }
        }

        @media (max-width: 480px) {
            .trust-strip    { grid-template-columns: 1fr 1fr; }
            .category-strip { grid-template-columns: repeat(3, 1fr); }
            .featured-grid  { grid-template-columns: 1fr 1fr; }
            .latest-grid    { grid-template-columns: 1fr 1fr; }
        }
    </style>

    {# ── Hero — imagen full width ── #}
    <div class="home-hero">
        <a href="{{ path('app_catalog') }}">
            <img src="/assets/hero.png" alt="Medielectro — Electrodomésticos y servicio técnico">
        </a>
    </div>

    {# ── Trust strip — propuesta de valor en 4 puntos ── #}
    <div class="trust-strip">
        <div class="trust-item">
            <div class="trust-item__icon">🔧</div>
            <div>
                <div class="trust-item__title">Servicio técnico</div>
                <div class="trust-item__sub">Reparación especializada</div>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-item__icon">🔌</div>
            <div>
                <div class="trust-item__title">Instalación profesional</div>
                <div class="trust-item__sub">En tu domicilio o negocio</div>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-item__icon">📍</div>
            <div>
                <div class="trust-item__title">Valencia</div>
                <div class="trust-item__sub">Tienda física y online</div>
            </div>
        </div>
        <div class="trust-item">
            <div class="trust-item__icon">📞</div>
            <div>
                <div class="trust-item__title">96 350 16 75</div>
                <div class="trust-item__sub">Atención personalizada</div>
            </div>
        </div>
    </div>

    {# ── Categorías ── #}
    <div class="home-section">
        <div class="home-section__header">
            <div>
                <h2>Categorías</h2>
                <p>Navega por las familias del catálogo</p>
            </div>
            <a class="btn" href="{{ path('app_catalog') }}">Ver todo →</a>
        </div>

        {# Mapa icono por palabras clave en el nombre de familia #}
        {% set iconMap = {
            'blanca': 'washing',
            'marron': 'tv',
            'hi-fi': 'music',
            'aire': 'snow',
            'calefac': 'fire',
            'cocina': 'cook',
            'frio': 'cold',
            'herramienta': 'tool',
            'accesorio': 'gear',
            'repuesto': 'gear',
            'iluminac': 'light',
            'pequeño': 'plug'
        } %}

        {% set svgIcons = {
            'washing': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="3"/><circle cx="12" cy="13" r="4"/><circle cx="7" cy="6" r="1" fill="currentColor"/></svg>',
            'tv':      '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 20h8M12 18v2"/></svg>',
            'music':   '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
            'snow':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93 4.93 19.07"/></svg>',
            'fire':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c0 6-6 8-6 14a6 6 0 0 0 12 0c0-6-6-8-6-14z"/></svg>',
            'cook':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11h18M3 7h18M3 15h18M3 19h18"/></svg>',
            'cold':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M5 10h14"/></svg>',
            'tool':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
            'gear':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>',
            'light':   '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 1 7 7c0 2.67-1.5 5-3.5 6.5V17H8.5v-1.5C6.5 14 5 11.67 5 9a7 7 0 0 1 7-7z"/></svg>',
            'plug':    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22V12M5 12H2a10 10 0 0 0 20 0h-3M8 12V6M16 12V6"/></svg>',
            'default': '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2M8 7V5a2 2 0 0 0-4 0v2"/></svg>'
        } %}

        <div class="category-strip">
            {% for family in families %}
                {% set iconKey = 'default' %}
                {% set nameLower = family.name|lower %}
                {% for keyword, key in iconMap %}
                    {% if keyword in nameLower %}{% set iconKey = key %}{% endif %}
                {% endfor %}
                <a class="category-chip" href="{{ path('app_catalog', {family: family.id}) }}">
                    <div class="category-chip__icon" style="color: var(--brand);">
                        {{ svgIcons[iconKey]|raw }}
                    </div>
                    <div class="category-chip__name">{{ family.name|title }}</div>
                </a>
            {% endfor %}
        </div>
    </div>

    {# ── Productos destacados ── #}
    <div class="home-section">
        <div class="home-section__header">
            <div>
                <h2>Productos disponibles</h2>
                <p>Con stock confirmado</p>
            </div>
            <a class="btn" href="{{ path('app_catalog', {inStock: 1}) }}">Ver más →</a>
        </div>

        <div class="featured-grid">
            {% for p in featuredProducts %}
                <a class="featured-card" href="{{ path('app_product_show', {article: p.article}) }}">
                    <div class="featured-card__img">
                        {% if p.image %}
                            <img src="{{ p.image }}" alt="{{ p.title }}">
                        {% else %}
                            <div class="featured-card__placeholder">
                                <div class="featured-card__placeholder-icon">📦</div>
                                {% if p.brand %}<span>{{ p.brand }}</span>{% endif %}
                            </div>
                        {% endif %}
                        {% if p.stock >= 5 %}
                            <span class="stock-badge stock-badge--ok">Disponible</span>
                        {% else %}
                            <span class="stock-badge stock-badge--warn">Consultar</span>
                        {% endif %}
                    </div>
                    <div class="featured-card__body">
                        {% if p.brand %}<div class="featured-card__brand">{{ p.brand }}</div>{% endif %}
                        <div class="featured-card__title">{{ p.title|striptags }}</div>
                        {% if p.family %}<div class="featured-card__family">{{ p.family.name }}</div>{% endif %}
                    </div>
                    <div class="featured-card__footer">
                        <span class="featured-card__price">{{ p.price|number_format(2, ',', '.') }} €</span>
                        <span class="featured-card__cta">Ver detalle →</span>
                    </div>
                </a>
            {% else %}
                <div style="grid-column:1/-1; text-align:center; padding:32px; color:var(--muted);">
                    No hay productos destacados disponibles.
                </div>
            {% endfor %}
        </div>
    </div>

    {# ── Banner promocional ── #}
    <div class="promo-banner">
        <div>
            <div class="promo-banner__eyebrow">Servicio técnico oficial</div>
            <h2>Reparamos tu electrodoméstico con garantía</h2>
            <p>Diagnóstico gratuito · Presupuesto sin compromiso · Reparación en Valencia</p>
        </div>
        <a class="promo-banner__action" href="#contacto">Pedir presupuesto →</a>
    </div>

    {# ── Marcas ── #}
    <div class="home-section">
        <div class="home-section__header">
            <div>
                <h2>Marcas</h2>
                <p>Trabajamos con los principales fabricantes</p>
            </div>
        </div>
        <div class="brands-strip">
            {% set topBrands = ['BOSCH', 'BALAY', 'SIEMENS', 'LG', 'SAMSUNG', 'WHIRLPOOL', 'CECOTEC', 'PHILIPS'] %}
            {% for brand in topBrands %}
                <a class="brand-item" href="{{ path('app_catalog', {brand: brand}) }}">{{ brand }}</a>
            {% endfor %}
        </div>
    </div>

    {# ── Servicios ── #}
    <div class="home-section" id="servicios">
        <div class="home-section__header">
            <div>
                <h2>Nuestros servicios</h2>
                <p>Más allá del catálogo</p>
            </div>
        </div>

        <div class="services-grid">
            <div class="service-card">
                <div class="service-card__icon">🔧</div>
                <div>
                    <h3>Reparación</h3>
                    <p>Diagnóstico y reparación de electrodomésticos con atención especializada y garantía de servicio.</p>
                </div>
            </div>
            <div class="service-card">
                <div class="service-card__icon">🔌</div>
                <div>
                    <h3>Instalación</h3>
                    <p>Instalación profesional en tu domicilio o negocio. Segura, rápida y con los materiales adecuados.</p>
                </div>
            </div>
        </div>
    </div>

    {# ── CTA banner contacto ── #}
    <div class="cta-banner">
        <div>
            <div class="cta-banner__tag">¿Necesitas ayuda?</div>
            <h2>Te orientamos para encontrar el producto o resolver la avería</h2>
            <p>Llámanos al 96 350 16 75, escríbenos o pasa por nuestra tienda en Valencia.</p>
        </div>
        <div class="cta-banner__actions">
            <a class="btn btn-primary" href="{{ path('app_catalog') }}">Ver catálogo</a>
            <a class="btn" href="#contacto">Contactar</a>
        </div>
    </div>

    {# ── Últimas incorporaciones ── #}
    <div class="home-section">
        <div class="home-section__header">
            <div>
                <h2>Últimas incorporaciones</h2>
                <p>Lo más reciente en catálogo</p>
            </div>
        </div>

        <div class="latest-grid">
            {% for p in latestProducts %}
                <a class="latest-card" href="{{ path('app_product_show', {article: p.article}) }}">
                    {% if p.brand %}<div class="latest-card__brand">{{ p.brand }}</div>{% endif %}
                    <div class="latest-card__title">{{ p.title|striptags|u.truncate(55, '…') }}</div>
                    {% if p.family %}<div class="latest-card__family">{{ p.family.name }}</div>{% endif %}
                    <div class="latest-card__price">{{ p.price|number_format(2, ',', '.') }} €</div>
                </a>
            {% endfor %}
        </div>
    </div>

{% endblock %}
