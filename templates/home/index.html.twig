{% extends 'base.html.twig' %}
{% block title %}Medielectro · Electrodomésticos en Valencia{% endblock %}

{% block body %}
<style>
    .hero-quicklinks { background: #2d2d2d; }
    .hero-quicklinks__inner { max-width: 1280px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; }
    .hero-quicklinks__item { flex: 1; display: flex; align-items: center; justify-content: center; padding: 14px 16px; font-size: 13px; font-weight: 700; color: rgba(255,255,255,.85); text-decoration: none; border-right: 1px solid rgba(255,255,255,.12); transition: color .15s, background .15s; text-align: center; }
    .hero-quicklinks__item:last-child { border-right: none; }
    .hero-quicklinks__item:hover { color: white; background: rgba(255,255,255,.06); }

    /* ── Carousel ── */
    .hero-carousel { position: relative; margin: 12px 32px; border-radius: 20px; overflow: hidden; height: 240px; }
    .hero-carousel__track { display: flex; height: 100%; transition: transform .5s cubic-bezier(.4,0,.2,1); }
    .hero-slide { min-width: 100%; height: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 56px; position: relative; overflow: hidden; }
    .hero-slide::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 80% 50%, rgba(0,0,0,.2) 0%, transparent 55%); }
    .hero-slide--catalog { background: var(--brand); }
    .hero-slide--install { background: linear-gradient(135deg, #0f3460 0%, #1a4a8a 100%); }
    .hero-slide__left { display: flex; flex-direction: column; gap: 12px; position: relative; z-index: 1; }
    .hero-slide__tag { display: inline-flex; align-items: center; gap: 6px; background: rgba(255,255,255,.2); border-radius: 999px; padding: 4px 14px; font-size: 11px; font-weight: 800; color: white; text-transform: uppercase; letter-spacing: .6px; width: fit-content; }
    .hero-slide__title { font-size: 38px; font-weight: 900; color: white; line-height: 1.05; letter-spacing: -1px; margin: 0; }
    .hero-slide__sub { font-size: 14px; color: rgba(255,255,255,.8); margin: 0; }
    .hero-slide__right { position: relative; z-index: 1; flex-shrink: 0; }
    .hero-slide__btn { display: inline-flex; align-items: center; gap: 8px; background: white; color: var(--brand); border-radius: 12px; padding: 14px 28px; font-size: 15px; font-weight: 900; text-decoration: none; transition: opacity .15s; white-space: nowrap; }
    .hero-slide--install .hero-slide__btn { color: #0f3460; }
    .hero-slide__btn:hover { opacity: .9; }
    /* Dots */
    .hero-dots { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); display: flex; gap: 7px; z-index: 10; }
    .hero-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,.4); border: none; cursor: pointer; padding: 0; transition: background .2s, transform .2s; }
    .hero-dot.active { background: #fff; transform: scale(1.3); }

    .home-section { margin: 48px 0; }
    .home-section__header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 20px; gap: 12px; }
    .home-section__title { font-size: 22px; font-weight: 900; margin: 0 0 4px; letter-spacing: -.3px; }
    .home-section__sub { font-size: 13px; color: var(--muted); margin: 0; }

    .featured-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
    .featured-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; text-decoration: none; color: inherit; transition: box-shadow .18s, transform .18s; display: flex; flex-direction: column; }
    .featured-card:hover { box-shadow: 0 8px 28px rgba(17,24,39,.1); transform: translateY(-2px); }
    .featured-card__img { aspect-ratio: 1/1; background: #f8fafc; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid var(--border); }
    .featured-card__img img { width: 100%; height: 100%; object-fit: cover; }
    .featured-card__body { padding: 12px; flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .featured-card__brand { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); }
    .featured-card__title { font-size: 13px; font-weight: 700; line-height: 1.3; }
    .featured-card__footer { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding-top: 10px; }
    .featured-card__price { font-size: 17px; font-weight: 900; letter-spacing: -.4px; }
    .featured-card__stock { font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 999px; }
    .featured-card__stock--ok { background: #effbf3; color: #15803d; }
    .featured-card__stock--warn { background: #fff7ea; color: #92400e; }
    .btn-cart-home { width: 100%; background: var(--brand); color: #fff; border: none; border-radius: 8px; padding: 10px; font-size: 13px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; transition: background .15s; font-family: inherit; margin-top: 10px; }
    .btn-cart-home:hover { background: #c0040f; }
    .btn-cart-home.added { background: #c0040f; }
    .btn-cart-home:disabled { opacity: .6; cursor: not-allowed; }

    .services-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .svc-banner { border-radius: 16px; padding: 32px; text-decoration: none; color: white; display: flex; flex-direction: column; gap: 12px; transition: opacity .15s; position: relative; overflow: hidden; min-height: 180px; }
    .svc-banner:hover { opacity: .92; }
    .svc-banner--repair { background: linear-gradient(135deg, #111827 0%, #1f2937 100%); }
    .svc-banner--repair::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(227,6,19,.25), transparent 55%); }
    .svc-banner--install { background: linear-gradient(135deg, #0f3460 0%, #16213e 100%); }
    .svc-banner--install::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at top right, rgba(255,255,255,.08), transparent 55%); }
    .svc-banner__eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: rgba(255,255,255,.6); position: relative; z-index: 1; }
    .svc-banner__title { font-size: 20px; font-weight: 900; margin: 0; letter-spacing: -.3px; position: relative; z-index: 1; }
    .svc-banner__cta { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: rgba(255,255,255,.8); margin-top: auto; position: relative; z-index: 1; }

    .brands-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
    .brand-card { background: var(--card); border: 1.5px solid var(--border); border-radius: 14px; padding: 24px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-decoration: none; transition: border-color .18s, box-shadow .18s, transform .18s; min-height: 100px; }
    .brand-card:hover { border-color: var(--brand); box-shadow: 0 4px 20px rgba(227,6,19,.1); transform: translateY(-2px); }
    .brand-card { position: relative; }
    .brand-card__logo-wrap { width: 100%; height: 56px; display: flex; align-items: center; justify-content: center; }
    .brand-card__logo { width: 100%; height: 100%; object-fit: contain; filter: grayscale(1) opacity(.65); transition: filter .2s; }
    .brand-card:hover .brand-card__logo { filter: grayscale(0) opacity(1); }
    .brand-card:hover .brand-card__logo { filter: grayscale(0) opacity(1); }
    .brand-card__name { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); text-align: center; }

    .home-cta { background: var(--brand); border-radius: 20px; padding: 40px; display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .home-cta h2 { font-size: 24px; font-weight: 900; color: white; margin: 0 0 6px; letter-spacing: -.3px; }
    .home-cta p { font-size: 14px; color: rgba(255,255,255,.8); margin: 0; }
    .home-cta__btn { display: inline-flex; align-items: center; gap: 8px; background: white; color: var(--brand); border-radius: 12px; padding: 14px 28px; font-size: 15px; font-weight: 800; text-decoration: none; white-space: nowrap; transition: opacity .15s; flex-shrink: 0; }
    .home-cta__btn:hover { opacity: .9; }

    @media (max-width: 900px) {
        .hero-slide { padding: 0 28px; }
        .hero-slide__title { font-size: 28px; }
        .featured-grid { grid-template-columns: repeat(2, 1fr); }
        .services-duo { grid-template-columns: 1fr; }
        .hero-quicklinks__item { flex: none; width: 50%; border-right: none; border-bottom: 1px solid rgba(255,255,255,.1); }
    }
    @media (max-width: 600px) {
        .featured-grid {
            display: flex !important;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 12px;
            padding-bottom: 8px;
            scrollbar-width: none;
        }
        .featured-grid::-webkit-scrollbar { display: none; }
        .featured-card {
            flex: 0 0 72vw !important;
            scroll-snap-align: start;
        }
    }
    @media (max-width: 600px) {
        .brands-grid {
            display: flex !important;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            gap: 10px;
            padding-bottom: 8px;
            scrollbar-width: none;
            grid-template-columns: unset;
        }
        .brands-grid::-webkit-scrollbar { display: none; }
        .brand-card {
            flex: 0 0 28vw;
            scroll-snap-align: start;
            min-height: 80px;
            padding: 16px 10px;
        }
        .brand-card__logo-wrap { height: 40px; }
    }
    @media (max-width: 600px) {
        .hero-carousel { height: 160px !important; margin: 8px 12px !important; border-radius: 14px !important; }
        .hero-slide { padding: 16px 20px !important; flex-direction: column !important; align-items: flex-start !important; justify-content: center !important; gap: 8px !important; }
        .hero-slide__left { gap: 6px !important; }
        .hero-slide__tag { font-size: 9px !important; padding: 3px 8px !important; }
        .hero-slide__title { font-size: 20px !important; letter-spacing: -.5px !important; }
        .hero-slide__sub { font-size: 11px !important; display: none; }
        .hero-slide__right { width: 100%; }
        .hero-slide__btn { font-size: 11px !important; padding: 7px 14px !important; border-radius: 8px !important; }
        .hero-quicklinks { display: none; }
        .featured-grid { display: flex !important; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; padding-bottom: 8px; scrollbar-width: none; }
        .featured-grid::-webkit-scrollbar { display: none; }
        .featured-card { flex: 0 0 72vw !important; scroll-snap-align: start; }
        .brands-grid { display: flex !important; overflow-x: auto; scroll-snap-type: x mandatory; gap: 10px; padding-bottom: 8px; scrollbar-width: none; grid-template-columns: unset; }
        .brands-grid::-webkit-scrollbar { display: none; }
        .brand-card { flex: 0 0 28vw; scroll-snap-align: start; min-height: 80px; padding: 16px 10px; }
        .brand-card__logo-wrap { height: 40px; }
    }
</style>

{# ── HERO CAROUSEL ── #}
<div class="hero-carousel" id="heroCarousel">
    <div class="hero-carousel__track" id="heroTrack">

        {# Slide 1: Catálogo #}
        <div class="hero-slide hero-slide--catalog">
            <div class="hero-slide__left">
                <span class="hero-slide__tag">Catálogo actualizado a diario</span>
                <h1 class="hero-slide__title">+600 productos<br>disponibles</h1>
                <p class="hero-slide__sub">Electrodomésticos en Valencia con instalación y servicio técnico</p>
            </div>
            <div class="hero-slide__right">
                <a class="hero-slide__btn" href="{{ path('app_catalog') }}">
                    Ver catálogo
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>

        {# Slide 2: Instalación #}
        <div class="hero-slide hero-slide--install">
            <div class="hero-slide__left">
                <span class="hero-slide__tag">Servicio profesional</span>
                <h2 class="hero-slide__title">Instalación<br>a domicilio</h2>
                <p class="hero-slide__sub">Instalamos tu electrodoméstico donde lo necesites, con garantía</p>
            </div>
            <div class="hero-slide__right">
                <a class="hero-slide__btn" href="{{ path('app_service_instalacion') }}">
                    Solicitar instalación
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
            </div>
        </div>

    </div>
    <div class="hero-dots">
        <button class="hero-dot active" data-slide="0"></button>
        <button class="hero-dot" data-slide="1"></button>
    </div>
</div>

<div class="container">
    {# ── PRODUCTOS DESTACADOS ── #}
    <section class="home-section">
        <div class="home-section__header">
            <div>
                <h2 class="home-section__title">Productos destacados</h2>
                <p class="home-section__sub">Selección con disponibilidad inmediata</p>
            </div>

        </div>
        <div class="featured-grid">
            {% for p in featuredProducts|slice(0, 4) %}
                <div class="featured-card">
                    <a href="{{ path('app_product_show', {article: p.article}) }}" style="text-decoration:none;color:inherit">
                        <div class="featured-card__img">
                            {% if p.image %}
                                <img src="{{ p.image }}" alt="{{ p.title }}">
                            {% endif %}
                        </div>
                        <div class="featured-card__body">
                            {% if p.brand %}<div class="featured-card__brand">{{ p.brand }}</div>{% endif %}
                            <div class="featured-card__title">{{ p.title|striptags }}</div>
                            <div class="featured-card__footer">
                                <span class="featured-card__price">{{ p.price|number_format(2,',','.') }} €</span>
                                {% if p.stock >= 5 %}
                                    <span class="featured-card__stock featured-card__stock--ok">Disponible</span>
                                {% else %}
                                    <span class="featured-card__stock featured-card__stock--warn">Consultar</span>
                                {% endif %}
                            </div>
                        </div>
                    </a>
                    <div style="padding:0 12px 12px">
                        <button class="btn-cart-home" type="button"
                                data-url="{{ path('app_cart_add', {article: p.article}) }}">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61h9.72a2 2 0 001.99-1.61L23 6H6"/>
                            </svg>
                            Añadir al carrito
                        </button>
                    </div>
                </div>
            {% else %}
                <p style="color:var(--muted)">No hay productos destacados.</p>
            {% endfor %}
        </div>
    </section>

    {# ── SERVICIOS ── #}
    <section class="home-section" id="servicios">
        <div class="home-section__header">
            <div>
                <h2 class="home-section__title">Nuestros servicios</h2>
                <p class="home-section__sub">Más allá del catálogo</p>
            </div>
        </div>
        <div class="services-duo">
            <a class="svc-banner svc-banner--repair" href="{{ path('app_service_reparacion') }}">
                <span class="svc-banner__eyebrow">Servicio técnico</span>
                <h3 class="svc-banner__title">Reparación de electrodomésticos</h3>
                <span class="svc-banner__cta">Solicitar reparación <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </a>
            <a class="svc-banner svc-banner--install" href="{{ path('app_service_instalacion') }}">
                <span class="svc-banner__eyebrow">Instalación profesional</span>
                <h3 class="svc-banner__title">Instalación en tu domicilio</h3>
                <span class="svc-banner__cta">Solicitar instalación <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
            </a>
        </div>
    </section>

    {# ── MARCAS ── #}
    <section class="home-section">
        <div class="home-section__header">
            <div>
                <h2 class="home-section__title">Marcas</h2>
                <p class="home-section__sub">Trabajamos con los principales fabricantes</p>
            </div>
        </div>
        <div class="brands-grid">
            {% set topBrands = [
                {name: 'BOSCH',     logo: '/img/brands/bosch.svg'},
                {name: 'BALAY',     logo: '/img/brands/balay.svg'},
                {name: 'SIEMENS',   logo: '/img/brands/siemens.png'},
                {name: 'LG',        logo: '/img/brands/lg.svg'},
                {name: 'SAMSUNG',   logo: '/img/brands/samsung.png'},
                {name: 'AEG',       logo: '/img/brands/aeg.svg'},
                {name: 'PHILIPS',   logo: '/img/brands/Phillips-Logo-2008.png'},
                {name: 'TEKA',      logo: '/img/brands/teka.svg',      scale: '1.6'},
                {name: 'WHIRLPOOL', logo: '/img/brands/whirlpool.svg'},
                {name: 'ROWENTA',   logo: '/img/brands/rowenta.jpg'}
            ] %}
            {% for b in topBrands %}
                <a class="brand-card" href="{{ path('app_catalog', {brand: b.name}) }}">
                    <div class="brand-card__logo-wrap">
                        <img class="brand-card__logo" src="{{ b.logo }}" alt="{{ b.name }}">
                    </div>
                </a>
            {% endfor %}
        </div>
    </section>

    {# ── CTA FINAL ── #}
    <section class="home-section">
        <div class="home-cta" style="justify-content:center;text-align:center">
            <div>
                <h2>¿Necesitas ayuda para elegir?</h2>
                <p>Te orientamos sin compromiso. Llámanos al <strong style="color:#fff">96 350 16 75</strong> o visítanos en tienda.</p>
            </div>
        </div>
    </section>
</div>

<script>
(function () {
    var track  = document.getElementById('heroTrack');
    var dots   = document.querySelectorAll('.hero-dot');
    var current = 0;
    var total   = 2;
    var timer;

    function goTo(idx) {
        current = idx;
        track.style.transform = 'translateX(-' + (idx * 100) + '%)';
        dots.forEach(function (d, i) { d.classList.toggle('active', i === idx); });
    }

    function next() { goTo((current + 1) % total); }

    dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
            clearInterval(timer);
            goTo(parseInt(this.dataset.slide));
            timer = setInterval(next, 5000);
        });
    });

    timer = setInterval(next, 5000);
})();
</script>
<script>
(function () {
    document.querySelectorAll('.btn-cart-home').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            var orig = this.innerHTML;
            this.disabled = true;
            try {
                var res  = await fetch(this.dataset.url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ quantity: 1 })
                });
                var data = await res.json();
                document.querySelectorAll('[data-cart-count]').forEach(function (el) {
                    el.textContent = data.count;
                    el.style.display = 'flex';
                });
                this.classList.add('added');
                this.innerHTML = 'Añadido';
                var self = this;
                setTimeout(function () { self.innerHTML = orig; self.classList.remove('added'); self.disabled = false; }, 2000);
            } catch (e) {
                this.innerHTML = orig;
                this.disabled = false;
            }
        });
    });
})();
</script>
{% endblock %}
